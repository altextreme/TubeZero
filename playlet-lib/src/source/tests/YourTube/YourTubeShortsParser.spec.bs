' YourTube: Shorts tab parsers against real InnerTube WEB fixtures (search with the shorts filter,
' reel/reel_watch_sequence and reel/reel_item_watch, trimmed) in source/tests/fixtures/yourtube/.
import "pkg:/components/YourTube/Shorts/YourTubeShortsParser.bs"
import "pkg:/source/utils/StringUtils.bs"

namespace Tests

    @suite
    class YourTubeShortsParserTests extends Rooibos.BaseTestSuite

        function Fixture(name as string) as dynamic
            return StringUtils.ParseJsonSafe(ReadAsciiFile("pkg:/source/tests/fixtures/yourtube/" + name))
        end function

        @describe("YourTubeShorts.EncodeSequenceParams")

        @it("encodes the ReelSequence protobuf exactly like youtubei.js")
        function _()
            ' the value that fetched reel-sequence.json
            m.assertEqual(YourTubeShorts.EncodeSequenceParams("amjeClv6zyg"), "CgthbWplQ2x2Nnp5ZyoCGAVQGWgA")
        end function

        @it("URL-escapes base64 padding and symbols")
        function _()
            m.assertEqual(YourTubeShorts.UrlEscapeBase64("a+b/c=="), "a%2Bb%2Fc%3D%3D")
        end function

        @describe("YourTubeShorts.ParseSequence")

        @it("parses the entries and the continuation")
        function _()
            sequence = YourTubeShorts.ParseSequence(m.Fixture("reel-sequence.json"))
            m.assertEqual(sequence.shorts.Count(), 10)
            first = sequence.shorts[0]
            m.assertEqual(first.videoId, "cVNJH0wzv4g")
            m.assertEqual(first.thumbnail, "https://i.ytimg.com/vi/cVNJH0wzv4g/frame0.jpg")
            m.assertEqual(first.channel, "Rufus Goodboy")
            m.assertEqual(first.channelId, "UC6T4TmdMIg3bPWd9at6vFRQ")
            m.assertTrue(first.title.StartsWith("Ranking My Funniest Dog Voiceovers"))
            m.assertEqual(sequence.shorts[9].videoId, "tFAPsS9Hzog")
            m.assertTrue(sequence.continuation.Len() > 20)
        end function

        @it("leaves title and channel empty for entries without prefetched details")
        function _()
            second = YourTubeShorts.ParseSequence(m.Fixture("reel-sequence.json")).shorts[1]
            m.assertEqual(second.videoId, "UWOLSHz6ufg")
            m.assertEqual(second.title, "")
            m.assertEqual(second.channel, "")
            m.assertEqual(second.channelId, "")
        end function

        @it("returns empty values for bad input")
        function _()
            m.assertEqual(YourTubeShorts.ParseSequence(invalid).shorts.Count(), 0)
            m.assertEqual(YourTubeShorts.ParseSequence({ "entries": [1, "x", {}] }).shorts.Count(), 0)
            m.assertEqual(YourTubeShorts.ParseSequence({}).continuation, "")
        end function

        @it("falls back to the frame0 thumbnail")
        function _()
            json = { "entries": [{ "command": { "reelWatchEndpoint": { "videoId": "abcdefghijk" } } }] }
            m.assertEqual(YourTubeShorts.ParseSequence(json).shorts[0].thumbnail, "https://i.ytimg.com/vi/abcdefghijk/frame0.jpg")
        end function

        @describe("YourTubeShorts.ParseSearchSeeds")

        @it("collects the Shorts of every shelf, without duplicates")
        function _()
            seeds = YourTubeShorts.ParseSearchSeeds(m.Fixture("shorts-search.json"))
            m.assertEqual(seeds.Count(), 6)
            m.assertEqual(seeds[0].videoId, "amjeClv6zyg")
            m.assertEqual(seeds[0].viewsText, "2.7M views")
            m.assertTrue(seeds[0].title.StartsWith("Ranking Top 5 Funniest Moments"))
            m.assertEqual(seeds[0].thumbnail, "https://i.ytimg.com/vi/amjeClv6zyg/frame0.jpg")
            m.assertEqual(seeds[3].videoId, "O79Alu1k3OU")
        end function

        @it("returns no seeds for bad input")
        function _()
            m.assertEqual(YourTubeShorts.ParseSearchSeeds(invalid).Count(), 0)
            m.assertEqual(YourTubeShorts.ParseSearchSeeds({ "contents": "x" }).Count(), 0)
        end function

        @describe("YourTubeShorts.ParseReelItem")

        @it("reads title, channel, views and likes from the description panel")
        function _()
            info = YourTubeShorts.ParseReelItem(m.Fixture("reel-item.json"))
            m.assertTrue(info.title.StartsWith("Ranking Top 5 Funniest Moments On The Internet"))
            m.assertEqual(info.channel, "RankVault")
            m.assertEqual(info.viewsText, "2,798,149 views")
            m.assertEqual(info.likesText, "17K")
        end function

        @it("falls back to the player overlay")
        function _()
            data = m.Fixture("reel-item.json")
            data["engagementPanels"] = []
            info = YourTubeShorts.ParseReelItem(data)
            m.assertTrue(info.title.StartsWith("Ranking Top 5 Funniest Moments On The Internet"))
            m.assertEqual(info.channel, "@ItsRankVault")
            m.assertEqual(info.viewsText, "")
            m.assertEqual(info.likesText, "17K")
        end function

        @it("reads the channel id and the comment count")
        function _()
            info = YourTubeShorts.ParseReelItem(m.Fixture("reel-item.json"))
            m.assertEqual(info.channelId, "UC1TNXIu5eE5zzTypxR_VqXA")
            m.assertEqual(info.commentsText, "738")
        end function

        @it("takes the channel id and comment count from the overlay alone")
        function _()
            data = m.Fixture("reel-item.json")
            data["engagementPanels"] = []
            info = YourTubeShorts.ParseReelItem(data)
            m.assertEqual(info.channelId, "UC1TNXIu5eE5zzTypxR_VqXA")
            m.assertEqual(info.commentsText, "738")
        end function

        @it("falls back to the comments panel header for the count, and ignores a count-less button")
        function _()
            data = m.Fixture("reel-item.json")
            buttons = data["overlay"]["reelPlayerOverlayRenderer"]["playerOverlay"]["reelPlayerOverlayViewModel"]["actionBar"]["reelActionBarViewModel"]["buttonViewModels"]
            buttons[1]["buttonViewModel"]["title"] = "Comments"
            data["engagementPanels"][0]["engagementPanelSectionListRenderer"]["header"]["engagementPanelTitleHeaderRenderer"]["contextualInfo"]["runs"][0]["text"] = "1.2K"
            m.assertEqual(YourTubeShorts.ParseReelItem(data).commentsText, "1.2K")
            data["engagementPanels"] = []
            m.assertEqual(YourTubeShorts.ParseReelItem(data).commentsText, "")
        end function

        @it("returns empty values for bad input")
        function _()
            info = YourTubeShorts.ParseReelItem(invalid)
            m.assertEqual(info.title, "")
            m.assertEqual(info.likesText, "")
            m.assertEqual(info.channelId, "")
            m.assertEqual(info.commentsText, "")
        end function

        @describe("YourTubeShorts.ChannelIdOrEmpty")

        @it("keeps UC channel ids only")
        function _()
            m.assertEqual(YourTubeShorts.ChannelIdOrEmpty("UC1TNXIu5eE5zzTypxR_VqXA"), "UC1TNXIu5eE5zzTypxR_VqXA")
            m.assertEqual(YourTubeShorts.ChannelIdOrEmpty("FEhashtag"), "")
            m.assertEqual(YourTubeShorts.ChannelIdOrEmpty(invalid), "")
            m.assertEqual(YourTubeShorts.ChannelIdOrEmpty(12), "")
        end function

        @describe("YourTubeShorts.ParseSubscriptionShorts")

        ' subscriptions-shorts.json is synthetic (the signed-in feed can't be captured ahead of time): TV tiles
        ' in shelves plus the WEB renderer shapes the parser also accepts.
        @it("collects the Shorts in feed order, skipping videos and duplicates")
        function _()
            shorts = YourTubeShorts.ParseSubscriptionShorts(m.Fixture("subscriptions-shorts.json"))
            ids = []
            for each item in shorts
                ids.Push(item.videoId)
            end for
            m.assertEqual(ids.Join(","), "shortAAAAA1,shortBBBBB2,shortDDDDD4,shortEEEEE5,shortGGGGG7,shortHHHHH8")
        end function

        @it("reads titles, channels and views where the entry has them")
        function _()
            shorts = YourTubeShorts.ParseSubscriptionShorts(m.Fixture("subscriptions-shorts.json"))
            m.assertEqual(shorts[0].title, "First Short")
            m.assertEqual(shorts[0].channelId, "UCchannelAAAAAAAAAAAAAAA")
            m.assertEqual(shorts[0].thumbnail, "https://i.ytimg.com/vi/shortAAAAA1/frame0.jpg")
            m.assertEqual(shorts[1].title, "Second Short")
            m.assertEqual(shorts[1].channelId, "")
            m.assertEqual(shorts[3].title, "Grid Short")
            m.assertEqual(shorts[3].channel, "Channel E")
            m.assertEqual(shorts[3].channelId, "UCchannelEEEEEEEEEEEEEEE")
            m.assertEqual(shorts[3].viewsText, "12K views")
            m.assertEqual(shorts[4].title, "Lockup Short")
            m.assertEqual(shorts[4].viewsText, "3.1M views")
            m.assertEqual(shorts[5].title, "Reel item Short")
        end function

        @it("stops at maxCount")
        function _()
            shorts = YourTubeShorts.ParseSubscriptionShorts(m.Fixture("subscriptions-shorts.json"), 2)
            m.assertEqual(shorts.Count(), 2)
            m.assertEqual(shorts[1].videoId, "shortBBBBB2")
        end function

        @it("finds no Shorts in a feed of regular videos or bad input")
        function _()
            m.assertEqual(YourTubeShorts.ParseSubscriptionShorts(m.Fixture("subscribed-channels-tv.json")).Count(), 0)
            m.assertEqual(YourTubeShorts.ParseSubscriptionShorts(invalid).Count(), 0)
            m.assertEqual(YourTubeShorts.ParseSubscriptionShorts({ "contents": [1, "x", {}] }).Count(), 0)
        end function

        @it("keeps video ids that differ only in case apart")
        function _()
            json = { "items": [{ "reelWatchEndpoint": { "videoId": "abcDEF12345" } }, { "reelWatchEndpoint": { "videoId": "ABCdef12345" } }] }
            m.assertEqual(YourTubeShorts.ParseSubscriptionShorts(json).Count(), 2)
        end function

        @describe("YourTubeShorts.StatsLine")

        @it("joins the parts that exist")
        function _()
            m.assertEqual(YourTubeShorts.StatsLine("2.7M views", "17K"), "2.7M views  ·  17K likes")
            m.assertEqual(YourTubeShorts.StatsLine("", "17K"), "17K likes")
            m.assertEqual(YourTubeShorts.StatsLine("", ""), "")
        end function

    end class

end namespace
