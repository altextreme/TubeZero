' YourTube: discovery features (channel search, Home chips, Subscriptions filters, live now, search chips).
' Fixtures are signed-out WEB responses captured with youtubei.js (raw execute) into fixtures/yourtube/.
import "pkg:/components/YourTube/ChannelSearch/YourTubeChannelSearch.bs"
import "pkg:/components/YourTube/FeedFilters/YourTubeFeedFilters.bs"
import "pkg:/components/YourTube/HomeChips/YourTubeHomeChips.bs"
import "pkg:/components/YourTube/LiveNow/YourTubeLiveNow.bs"
import "pkg:/components/YourTube/SearchChips/YourTubeSearchChips.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/StringUtils.bs"

namespace Tests

    @suite
    class YourTubeDiscoveryTests extends Rooibos.BaseTestSuite

        function Fixture(name as string) as dynamic
            return StringUtils.ParseJsonSafe(ReadAsciiFile("pkg:/source/tests/fixtures/yourtube/" + name))
        end function

        function FakeRequest() as object
            return HttpClient.Post("https://www.youtube.com/youtubei/v1/browse")
        end function

        @describe("YourTubeChannelSearch.ParseResponse")

        @it("finds the search tab's content")
        function _()
            content = YourTubeChannelSearch.GetSearchTabContent(m.Fixture("channel-search.json"))
            m.assertNotInvalid(content)
            m.assertNotInvalid(content["sectionListRenderer"])
        end function

        @it("parses the first page: videos by the channel and a continuation")
        function _()
            result = YourTubeChannelSearch.ParseResponse("UCBJycsmduvYEL83R_U4JriQ", m.Fixture("channel-search.json"), m.FakeRequest(), true)
            m.assertInvalid(result.error)
            m.assertTrue(result.items.Count() >= 3)
            first = result.items[0]
            m.assertEqual(first["type"], "video")
            m.assertEqual(Len(first["videoId"]), 11)
            m.assertTrue(Len(first["title"]) > 0)
            m.assertTrue(Len(result.continuation) > 20)
        end function

        @it("parses a continuation page")
        function _()
            result = YourTubeChannelSearch.ParseResponse("UCBJycsmduvYEL83R_U4JriQ", m.Fixture("channel-search-page2.json"), m.FakeRequest(), false)
            m.assertTrue(result.items.Count() >= 2)
            m.assertEqual(result.items[0]["type"], "video")
        end function

        @it("returns no items without a search tab")
        function _()
            result = YourTubeChannelSearch.ParseResponse("UC1", { contents: {} }, m.FakeRequest(), true)
            m.assertEqual(result.items.Count(), 0)
            m.assertInvalid(result.continuation)
            m.assertInvalid(YourTubeChannelSearch.GetSearchTabContent(invalid))
        end function

        @describe("YourTubeHomeChips.Parse")

        @it("reads chipCloudChipRenderer chips with their continuation tokens")
        function _()
            chips = YourTubeHomeChips.Parse(m.Fixture("chips.json")["search"])
            m.assertEqual(chips.Count(), 6)
            m.assertEqual(chips[0].title, "All")
            m.assertTrue(chips[0].isSelected)
            m.assertEqual(chips[0].continuation, "")
            m.assertEqual(chips[1].title, "Shorts")
            m.assertFalse(chips[1].isSelected)
            m.assertTrue(Len(chips[1].continuation) > 20)
        end function

        @it("reads chipViewModel chips")
        function _()
            chips = YourTubeHomeChips.Parse(m.Fixture("chips.json")["channelVideos"])
            m.assertEqual(chips.Count(), 3)
            m.assertEqual(chips[0].title, "Latest")
            m.assertTrue(chips[0].isSelected)
            m.assertEqual(chips[1].title, "Popular")
            m.assertTrue(Len(chips[1].continuation) > 20)
        end function

        @it("returns no chips for pages without a chip bar")
        function _()
            m.assertEqual(YourTubeHomeChips.Parse(m.Fixture("channel-search.json")).Count(), 0)
            m.assertEqual(YourTubeHomeChips.Parse(invalid).Count(), 0)
        end function

        @describe("YourTubeHomeChips.BuildServerChips")

        @it("puts All first and keeps topics with a token")
        function _()
            chips = YourTubeHomeChips.BuildServerChips(YourTubeHomeChips.Parse(m.Fixture("chips.json")["search"]))
            m.assertEqual(chips.Count(), 6)
            m.assertEqual(chips[0].title, "All")
            m.assertEqual(chips[0].continuation, "")
            m.assertEqual(chips[1].title, "Shorts")
            m.assertEqual(chips[5].title, "Live")
        end function

        @it("returns nothing when only the selected chip has no token")
        function _()
            chips = YourTubeHomeChips.BuildServerChips([{ title: "All", continuation: "", isSelected: true }])
            m.assertEqual(chips.Count(), 0)
            m.assertEqual(YourTubeHomeChips.BuildServerChips(invalid).Count(), 0)
        end function

        @describe("YourTubeHomeChips fixed chips")

        @it("filters a home layout to the chip's rows in chip order")
        function _()
            feeds = [{ id: "recommended" }, { id: "trending_livestreams" }, { id: "music" }, { id: "subscriptions_live" }]
            live = YourTubeHomeChips.FixedChips()[1]
            m.assertEqual(live.title, "Live")
            rows = YourTubeHomeChips.FilterFeeds(feeds, live.rows)
            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].id, "subscriptions_live")
            m.assertEqual(rows[1].id, "trending_livestreams")
            m.assertEqual(YourTubeHomeChips.FilterFeeds(feeds, ["nope"]).Count(), 0)
        end function

        @it("builds a topic row that reloads the signed-in home with the chip token")
        function _()
            feed = YourTubeHomeChips.CreateChipFeed("Music", "TOKEN", 2)
            m.assertEqual(feed.title, "Music")
            m.assertEqual(feed.feedSources[0].endpoint, "yt_home_shelves")
            m.assertEqual(feed.feedSources[0].queryParams.chip, "TOKEN")
        end function

        @describe("YourTubeFeedFilters")

        @it("keeps everything with no filter, only videos otherwise")
        function _()
            playlist = { type: "playlist", title: "Mix" }
            m.assertTrue(YourTubeFeedFilters.Matches(playlist, ""))
            m.assertFalse(YourTubeFeedFilters.Matches(playlist, "today"))
            m.assertFalse(YourTubeFeedFilters.Matches(invalid, "videos"))
        end function

        @it("Today: seconds/minutes/hours ago in the published text or the TV client's lines")
        function _()
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video", publishedText: "3 hours ago" }, "today"))
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video", lines: ["Channel", "12K views • 1 hour ago"] }, "today"))
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video", videoInfo: "Streamed 5 minutes ago" }, "today"))
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video", liveNow: true }, "today"))
            m.assertFalse(YourTubeFeedFilters.Matches({ type: "video", publishedText: "1 day ago" }, "today"))
            m.assertFalse(YourTubeFeedFilters.Matches({ type: "video", publishedText: "2 weeks ago" }, "today"))
            m.assertFalse(YourTubeFeedFilters.Matches({ type: "video" }, "today"))
        end function

        @it("Unwatched: not started")
        function _()
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video" }, "unwatched"))
            m.assertTrue(YourTubeFeedFilters.Matches({ type: "video", percentDurationWatched: 0 }, "unwatched"))
            m.assertFalse(YourTubeFeedFilters.Matches({ type: "video", percentDurationWatched: 42 }, "unwatched"))
        end function

        @it("Live now, Videos and Shorts")
        function _()
            live = { type: "video", liveNow: true, lengthText: "" }
            short = { type: "video", lengthText: "" }
            shortInvidious = { type: "video", lengthSeconds: 45, lengthText: "0:45" }
            video = { type: "video", lengthText: "12:34" }
            upcoming = { type: "video", isUpcoming: true, lengthText: "" }
            m.assertTrue(YourTubeFeedFilters.Matches(live, "live"))
            m.assertFalse(YourTubeFeedFilters.Matches(video, "live"))
            m.assertTrue(YourTubeFeedFilters.Matches(video, "videos"))
            m.assertFalse(YourTubeFeedFilters.Matches(live, "videos"))
            m.assertFalse(YourTubeFeedFilters.Matches(short, "videos"))
            m.assertFalse(YourTubeFeedFilters.Matches(upcoming, "videos"))
            m.assertTrue(YourTubeFeedFilters.Matches(short, "shorts"))
            m.assertTrue(YourTubeFeedFilters.Matches(shortInvidious, "shorts"))
            m.assertFalse(YourTubeFeedFilters.Matches(video, "shorts"))
            m.assertFalse(YourTubeFeedFilters.Matches(live, "shorts"))
            m.assertFalse(YourTubeFeedFilters.Matches(upcoming, "shorts"))
        end function

        @it("parses durations")
        function _()
            m.assertEqual(YourTubeFeedFilters.ParseDuration("1:02:03"), 3723)
            m.assertEqual(YourTubeFeedFilters.ParseDuration("0:45"), 45)
            m.assertEqual(YourTubeFeedFilters.ParseDuration(""), 0)
            m.assertEqual(YourTubeFeedFilters.ParseDuration("LIVE"), 0)
        end function

        @describe("YourTubeLiveNow.PickLive")

        @it("keeps live videos once each, in feed order, up to the limit")
        function _()
            items = [
                { type: "video", videoId: "aaaaaaaaaaa", liveNow: true }
                { type: "video", videoId: "bbbbbbbbbbb", liveNow: false }
                { type: "video", videoId: "ccccccccccc" }
                { type: "video", videoId: "aaaaaaaaaaa", liveNow: true }
                { type: "video", videoId: "ddddddddddd", liveNow: true }
                { type: "video", videoId: "eeeeeeeeeee", liveNow: true }
                "not an item"
            ]
            live = YourTubeLiveNow.PickLive(items, 2)
            m.assertEqual(live.Count(), 2)
            m.assertEqual(live[0].videoId, "aaaaaaaaaaa")
            m.assertEqual(live[1].videoId, "ddddddddddd")
            m.assertEqual(YourTubeLiveNow.PickLive(items, 20).Count(), 3)
        end function

        @it("returns nothing without live items")
        function _()
            m.assertEqual(YourTubeLiveNow.PickLive([{ type: "video", videoId: "x" }], 20).Count(), 0)
            m.assertEqual(YourTubeLiveNow.PickLive(invalid, 20).Count(), 0)
        end function

        @describe("YourTubeSearchChips")

        @it("labels unset chips with the filter name and set ones with the value")
        function _()
            chips = YourTubeSearchChips.Build({ date: "week", type: "", duration: "", features: [], sort: "views" })
            m.assertEqual(chips.texts, ["This week", "Type", "Duration", "Sort: View count"])
            m.assertEqual(chips.marked, [0, 3])
            m.assertEqual(YourTubeSearchChips.Build(invalid).marked.Count(), 0)
        end function

        @it("cycles a filter through its values and back to unset")
        function _()
            m.assertEqual(YourTubeSearchChips.NextValue("duration", ""), "short")
            m.assertEqual(YourTubeSearchChips.NextValue("duration", "short"), "medium")
            m.assertEqual(YourTubeSearchChips.NextValue("duration", "long"), "")
            m.assertEqual(YourTubeSearchChips.NextValue("type", invalid), "video")
            m.assertEqual(YourTubeSearchChips.NextValue("sort", "nonsense"), "date")
            m.assertEqual(YourTubeSearchChips.NextValue("features", ""), "")
        end function

    end class

end namespace
