import "pkg:/source/utils/Types.bs" ' YourTube

namespace PlaylistUtils
    function Open(contentNode as object, appController = invalid as object) as void
        ' YourTube: Kids mode never leaves the Kids home for other pages
        if ValidBool(m.global.ytKidsActive)
            return
        end if
        playlistView = CreateObject("roSGNode", "PlaylistView")
        if appController = invalid
            appController = m.appController
        end if
        appController@.PushScreen(playlistView)
        playlistView@.BindNode()
        ' Clone the playlist because the videos will be loaded as children.
        ' This allows the videos to be freed once the view is closed.
        playlistView.content = contentNode.clone(false)
    end function
end namespace
