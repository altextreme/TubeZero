<component name="HomeScreen" extends="Group" includes="AutoBind,Focus,ContextMenuProvider">
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <!-- YourTube: used by the top bar to open Search -->
        <field id="appController" type="node" bind="/AppController" />
        <!-- YourTube: empty state shown when every row comes back empty (screens override these in Init) -->
        <field id="profilesService" type="node" bind="/ProfilesService" />
        <field id="emptyIcon" type="string" value="pkg:/images/icons/ms/empty_home.png" />
        <field id="emptySignedOutTitle" type="string" value="Sign in for your recommended feed" />
        <field id="emptySignedOutMessage" type="string" value="Go to Profile and sign in with your YouTube account. Your recommendations show up here." />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="feedFile" type="string" value="libpkg:/config/default_home_layout.yaml" />
    </interface>
    <children>
        <!-- YourTube: YouTube TV top bar; rows start below it (were at y=50). First shelf uses big 480x270 cards. -->
        <YourTubeTopBar id="topBar" />
        <YourTubeEmptyState id="emptyState" visible="false" focusable="false" />
        <VideoRowList
            itemComponentName="RowCell"
            id="rowList"
            translation="[0,120]"
            numRows="2"
            rowitemSize="[[480,270],[350,196]]"
            rowItemSpacing="[[24,0],[25,0]]"
            rowHeights="[400,326]"
            itemSize="[1280,326]"
            itemSpacing="[0,65]"
            rowLabelOffset="[[90,20]]"
            focusXOffset="[90]"
            showRowLabel="[true]"
            rowFocusAnimationStyle="floatingfocus"
            variableWidthItems="true"
            focusBitmapUri="pkg:/images/focus-glow-padding-30.$$RES$$.9.png"
        />
    </children>
</component>