<component name="ProfileScreen" extends="Group" includes="AutoBind,Focus">
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <field id="profilesService" type="node" bind="/ProfilesService" />
        <field id="appController" type="node" bind="/AppController" />
        <field id="preferences" type="node" bind="/Preferences" />
    </interface>

    <children>
        <!-- YourTube: heading and a signed-out explanation -->
        <Label text="Accounts" color="0xF1F1F1FF" translation="[96,64]">
            <Font role="font" uri="font:BoldSystemFontFile" size="30" />
        </Label>
        <Label
            id="SignedOutHint"
            visible="false"
            width="760"
            wrap="true"
            color="0xAAAAAAFF"
            translation="[96,108]"
            text="Add your YouTube account to see your subscriptions, history and playlists, and to like, save and subscribe from the TV.">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
        <!-- YourTube: notifications inbox (YouTube profiles only; Up from the accounts row) -->
        <YourTubeNotificationsButton id="NotificationsButton" translation="[1000,60]" visible="false" />
        <RowList
            id="ProfileRowList"
            translation="[0,190]"
            numRows="2"
            rowitemSize="[[240,340]]"
            rowItemSpacing="[[0,0]]"
            itemSize="[1280,500]"
            focusXOffset="[165]"
            itemComponentName="ProfileRowListCell"
            rowFocusAnimationStyle="floatingfocus"
            drawFocusFeedback="false"
            focusBitmapUri="pkg:/images/focus-glow-padding-30.$$RES$$.9.png" />
    </children>
</component>