import "pkg:/components/Dialog/DialogUtils.bs"
import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Services/SearchHistory/SearchHistoryUtils.bs"
import "pkg:/components/YourTube/SearchChips/YourTubeSearchChips.bs" ' YourTube: result filter chips
import "pkg:/components/YourTube/YourTubeTheme.bs"
import "pkg:/source/utils/CryptoUtils.bs"
import "pkg:/source/utils/ErrorUtils.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/LoadingScreen.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/UrlUtils.bs"

function Init()
    m.top.focusable = true
    m.container = m.top.FindNode("container")
    m.keyboard = m.top.FindNode("keyboard")
    m.rowList = m.top.FindNode("rowList")
    m.scrollAnimation = m.top.FindNode("scrollAnimation")
    m.scrollAnimationInterpolator = m.top.FindNode("scrollAnimationInterpolator")
    m.suggestions = m.top.FindNode("suggestions")
    m.filtersButton = m.top.FindNode("filtersButton")
    ' YourTube: filter chips under the results
    m.filterChips = m.top.FindNode("filterChips")
    m.filterChips.focusable = false
    m.lastQuery = ""
    m.focusChipsAfterSearch = false
    ' YourTube: voice search (see OnTextChange)
    m.voiceHint = m.top.FindNode("voiceHint")
    m.voiceSearchTimer = m.top.FindNode("voiceSearchTimer")
    m.voiceSearchTimer.ObserveField("fire", FuncName(OnVoiceSearchTimer))
    m.lastKeyboardText = ""
    m.keyboard.ObserveField("focusedChild", FuncName(OnKeyboardFocusChange))

    m.rowList.screen = m.top

    textEditBox = m.keyboard.textEditBox
    textEditBox.voiceEntryType = "generic"
    textEditBox.voiceEnabled = true
    ' YourTube: YouTube TV-style keyboard and search field
    YourTubeStyleKeyboard(m.keyboard)

    m.top.filters = {
        date: ""
        type: ""
        duration: ""
        features: []
        sort: ""
    }

    m.top.ObserveField("filters", FuncName(OnFiltersChange))
end function

function OnNodeReady()
    m.rowlist@.BindNode()
    m.keyboard@.BindNode()
    m.keyboard.ObserveField("text", FuncName(OnTextChange))
    ' YourTube: SEARCH key on the keyboard
    m.keyboard.ObserveField("searchRequested", FuncName(OnKeyboardSearchRequested))
    m.suggestions.ObserveField("buttonFocused", FuncName(OnSearchButtonFocused))
    m.suggestions.ObserveField("buttonSelected", FuncName(OnSearchButtonSelected))
    m.filtersButton.ObserveField("buttonSelected", FuncName(OnFiltersButtonSelected))
    m.filterChips.ObserveField("selected", FuncName(OnFilterChipSelected))
    UpdateFilterChips()

    m.top.ObserveField("visible", FuncName(OnVisibilityChange))
    m.rowlist.ObserveFieldScoped("onError", FuncName(OnSearchError))

    SetNavigation(invalid, RemoteKeys.Back, m.navBar, function()
        ScrollUp()
    end function)
    SetNavigation(m.suggestions, RemoteKeys.Right, m.keyboard)
    SetNavigation(m.filtersButton, RemoteKeys.Right, m.keyboard)
    SetNavigation(m.keyboard, RemoteKeys.Left, m.suggestions)
    SetNavigation(m.suggestions, RemoteKeys.Left, m.navBar)
    SetNavigation(m.filtersButton, RemoteKeys.Left, m.navBar)
    SetNavigation(m.keyboard, RemoteKeys.Left, m.navBar)
    SetNavigation(m.rowList, RemoteKeys.Left, m.navBar, function()
        ScrollUp()
    end function)
    SetNavigation(m.filtersButton, RemoteKeys.Down, m.suggestions)
    SetNavigation(m.filtersButton, RemoteKeys.Down, m.keyboard)

    ' YourTube: results row <-> filter chips under it (before the catch-all Down below)
    SetNavigation(m.rowList, RemoteKeys.Down, m.filterChips)
    SetNavigation(m.filterChips, RemoteKeys.Down, m.filterChips)
    SetNavigation(m.filterChips, RemoteKeys.Up, m.rowList)
    SetNavigation(m.filterChips, RemoteKeys.Up, m.suggestions, function()
        ScrollUp()
    end function)
    SetNavigation(m.filterChips, RemoteKeys.Up, m.keyboard, function()
        ScrollUp()
    end function)
    SetNavigation(m.filterChips, RemoteKeys.Left, m.navBar, function()
        ScrollUp()
    end function)

    SetNavigation(invalid, RemoteKeys.Down, m.rowList, function()
        ScrollDown()
    end function)
    SetNavigation(m.rowList, RemoteKeys.Up, m.suggestions, function()
        ScrollUp()
    end function)

    SetNavigation(m.suggestions, RemoteKeys.Up, m.filtersButton)
    SetNavigation(m.keyboard, RemoteKeys.Up, m.filtersButton)

    ' YourTube: start on the keyboard, like the YouTube TV app (Playlet started on suggestions)
    m.currentNavigtionNode = m.keyboard
    ' Trigger suggestions
    OnTextChange()
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if

    if m.currentNavigtionNode.isSameNode(m.suggestions) and not m.suggestions.focusable
        m.currentNavigtionNode = m.keyboard
    end if
    NodeSetFocus(m.currentNavigtionNode, true)
    if m.currentNavigtionNode.isSameNode(m.suggestions)
        OnSearchButtonFocused()
    end if
end function

function OnTextChange() as void
    YourTubePadSearchField(m.keyboard) ' YourTube: the text box re-lays out its label on edits
    ' YourTube: Roku voice input drops a whole phrase into the text box at once, while keys add one
    ' character; when several arrive together on the keyboard, search once the text settles.
    text = m.keyboard.text
    m.voiceSearchTimer.control = "stop"
    if m.keyboard.isInFocusChain() and text.Len() - m.lastKeyboardText.Len() >= 3
        m.voiceSearchTimer.control = "start"
    end if
    m.lastKeyboardText = text
    if m.suggestions.isInFocusChain()
        return
    end if

    if m.searchSuggestionsJob <> invalid
        m.searchSuggestionsJob.cancel = true
    end if

    input = {
        "q": m.keyboard.text
        "invidious": m.invidious
        "preferences": m.preferences
        "searchScreen": m.top
    }

    m.searchSuggestionsJob = JobSystem.CreateCallback()
    JobSystem.QueueJob(m.jobQueue, Jobs.SearchSuggestionsJob, input, m.searchSuggestionsJob)
end function

function OnSearchSuggestions(event as object) as void
    m.searchSuggestionsJob = invalid
    result = event.GetData()

    if not IsAssociativeArray(result)
        return
    end if

    ' In case this is an old request, discard suggestions
    q = result.q
    if q <> m.keyboard.text
        return
    end if
    suggestions = result.response
    if suggestions = invalid
        return
    end if

    if q.len() > 0 and ArrayUtils.IndexOfString(suggestions, q) = -1
        suggestions.Unshift(q)
    end if
    ' YourTube: history and live suggestions can repeat each other; keep the first of each
    seen = {}
    unique = []
    for each suggestion in suggestions
        key = LCase(ValidString(suggestion).Trim())
        if key <> "" and not seen.DoesExist(key)
            seen[key] = true
            unique.Push(suggestion)
        end if
    end for
    ' YourTube: at most 5, like YouTube; more would run into the results row
    while unique.Count() > 5
        unique.Pop()
    end while
    suggestions = unique

    ' Capture current focused button and restore it after resetting the buttons
    buttonFocused = -1
    if m.suggestions.isInFocusChain()
        buttonFocused = m.suggestions.buttonFocused
    end if
    if buttonFocused >= m.suggestions.buttons.Count()
        buttonFocused = m.suggestions.buttons.Count() - 1
    end if
    m.suggestions.buttons = suggestions
    if buttonFocused <> -1
        m.suggestions.focusButton = buttonFocused
    end if
    m.suggestions.focusable = m.suggestions.buttons.Count() > 0
end function

' YourTube: search for whatever is typed when the SEARCH key is pressed
' YourTube: the voice hint shows while the keyboard has focus.
function OnKeyboardFocusChange() as void
    m.voiceHint.visible = m.keyboard.isInFocusChain()
end function

' YourTube: dictated text settled on the keyboard: search it.
function OnVoiceSearchTimer() as void
    if m.keyboard.isInFocusChain() and m.keyboard.text = m.lastKeyboardText
        OnKeyboardSearchRequested()
    end if
end function

function OnKeyboardSearchRequested() as void
    text = m.keyboard.text.Trim()
    if text = ""
        return
    end if
    SearchHistoryUtils.Save(m.preferences, text)
    Search(text)
end function

function OnFiltersButtonSelected()
    searchFilters = CreateObject("roSGNode", "SearchFilters")
    m.appController@.PushScreen(searchFilters)
    searchFilters.searchScreen = m.top
    searchFilters@.BindNode()
end function

function OnSearchButtonSelected()
    selected = m.suggestions.buttonSelected
    text = m.suggestions.buttons[selected]
    SearchHistoryUtils.Save(m.preferences, text)
    Search(text)
end function

function OnSearchButtonFocused() as void
    if not m.suggestions.isInFocusChain()
        return
    end if

    buttonCount = m.suggestions.buttons.Count()
    selected = m.suggestions.buttonFocused
    if selected >= buttonCount
        m.suggestions.focusButton = 0
    end if

    selected = m.suggestions.buttonFocused
    if selected >= m.suggestions.buttons.Count() or selected < 0
        return
    end if
    text = m.suggestions.buttons[selected]
    m.keyboard.text = text
end function

function OnFiltersChange()
    filterCount = 0
    filters = m.top.filters
    for each filter in filters
        value = filters[filter]
        if IsString(value) and value.len() > 0
            filterCount++
        else if IsArray(value) and value.Count() > 0
            filterCount += value.Count()
        end if
    end for
    if filterCount > 0
        m.filtersButton.text = `${Tr(Locale.Buttons.Filters)} (${filterCount})`
    else
        m.filtersButton.text = Tr(Locale.Buttons.Filters)
    end if
    UpdateFilterChips() ' YourTube
end function

' YourTube: chip labels follow the filters (set by the chips or by the Filters dialog)
function UpdateFilterChips() as void
    chips = YourTubeSearchChips.Build(m.top.filters)
    m.filterChips.chips = chips.texts
    m.filterChips.markedIndexes = chips.marked
end function

' YourTube: OK on a chip moves its filter to the next value and runs the search again
function OnFilterChipSelected() as void
    keys = YourTubeSearchChips.FilterKeys()
    index = m.filterChips.selected
    if index < 0 or index >= keys.Count() or m.lastQuery = ""
        return
    end if
    filters = m.top.filters
    filters[keys[index]] = YourTubeSearchChips.NextValue(keys[index], filters[keys[index]])
    m.top.filters = filters
    m.focusChipsAfterSearch = true
    Search(m.lastQuery)
end function

function SetFilterChipsShown(shown as boolean) as void
    m.filterChips.visible = shown
    m.filterChips.focusable = shown
end function

function Search(text as string)
    m.lastQuery = text ' YourTube: the chips search again with it
    m.rowlist.UnobserveFieldScoped("someContentReady")
    m.rowlist.ObserveFieldScoped("someContentReady", FuncName(OnSearchContentReady))
    ShowLoadingScreen()

    feedSource = {
        "id": `inv_search_${CryptoUtils.GetMd5(text)}`
        "title": `${Tr(Locale.NavBar.Search)} - ${text}`
        "apiType": "Invidious"
        "endpoint": "search"
        "queryParams": {
            "q": text
        }
    }

    filters = m.top.filters
    for each filter in filters
        value = filters[filter]
        if IsString(value) and value.len() > 0
            feedSource.queryParams[filter] = value
        else if IsArray(value) and value.Count() > 0
            feedSource.queryParams[filter] = {
                value: value
                arrayType: UrlUtils.QueryParamArrayType.CommaSeparated
            }
        end if
    end for

    m.rowList.feeds = [{
        "title": `${Tr(Locale.NavBar.Search)} - ${text}`
        "feedSources": [feedSource]
    }]
end function

function OnSearchContentReady() as void
    m.rowlist.UnobserveFieldScoped("someContentReady")

    focusChips = m.focusChipsAfterSearch
    m.focusChipsAfterSearch = false
    if not m.rowlist.someContentReady
        DialogUtils.ShowDialogEx({
            message: Tr(Locale.Dialogs.NoResultsFoundMessage)
            title: Tr(Locale.Dialogs.NoResultsFound)
        })
        m.rowlist.feeds = invalid
        m.rowlist.focusable = false
        ' YourTube: a chip filtered everything out; stay on the chips to change it back
        if not focusChips
            SetFilterChipsShown(false)
        end if
        HideLoadingScreen()
        return
    end if

    m.rowlist.focusable = true
    SetFilterChipsShown(true) ' YourTube
    if focusChips
        m.currentNavigtionNode = m.filterChips
        NodeSetFocus(m.filterChips, true)
    else
        m.currentNavigtionNode = m.rowList
        NodeSetFocus(m.rowlist, true)
        ' There's a bug with the floating focus indicator. If the rowList receives focus after the
        ' content is set, the focus indicator will be "off". This is why we set the content again.
        m.rowlist.content = m.rowlist.content
    end if
    ScrollDown()
    HideLoadingScreen()
end function

function OnSearchError()
    ' Note: we don't display an error dialog, VideoRowListRowContentJob will do that.
    m.rowlist.feeds = invalid
    m.rowlist.focusable = false
    m.focusChipsAfterSearch = false
    HideLoadingScreen()
end function

function OnVisibilityChange()
    if m.top.visible = false
        ClearSearch()
    else
        OnTextChange()
    end if
end function

function ClearSearch()
    m.keyboard.text = ""
    m.rowlist.feeds = invalid
    m.rowlist.focusable = false
    m.lastQuery = ""
    SetFilterChipsShown(false) ' YourTube
    ScrollUp()
end function

function ScrollUp() as void
    destination = m.scrollAnimationInterpolator.keyValue[0][1]
    current = m.container.translation[1]
    if current = destination
        return
    end if

    if m.scrollAnimation.state = "running" and m.scrollAnimationInterpolator.reverse = true
        return
    end if

    m.scrollAnimationInterpolator.reverse = true
    m.scrollAnimation.control = "start"
    SetSearchControlsVisible(true) ' YourTube
end function

function ScrollDown() as void
    destination = m.scrollAnimationInterpolator.keyValue[2][1]
    current = m.container.translation[1]
    if current = destination
        return
    end if

    if m.scrollAnimation.state = "running" and m.scrollAnimationInterpolator.reverse = false
        return
    end if

    m.scrollAnimationInterpolator.reverse = false
    m.scrollAnimation.control = "start"
    SetSearchControlsVisible(false) ' YourTube
end function

' YourTube: the results row sits higher than in Playlet, so the controls above it would overlap it
' once it scrolls up; hide them while the results have focus.
function SetSearchControlsVisible(visible as boolean) as void
    m.top.findNode("searchFieldPill").visible = visible
    m.suggestions.visible = visible
    m.keyboard.visible = visible
    m.filtersButton.visible = visible
    ' The result filter chips sit under the results row, off the bottom until the results scroll up
    m.filterChips.visible = not visible and m.filterChips.focusable
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    navigation = NavigationKeyHandler(key, press)
    if navigation.handled
        m.currentNavigtionNode = navigation.node
        if m.currentNavigtionNode.isSameNode(m.navBar)
            ' YourTube: start on the keyboard, like the YouTube TV app (Playlet started on suggestions)
            m.currentNavigtionNode = m.keyboard
        end if
        if m.currentNavigtionNode.isSameNode(m.suggestions)
            OnSearchButtonFocused()
        end if
        if m.currentNavigtionNode.isSameNode(m.keyboard)
            ' First section, grid, row and key
            m.keyboard.keyGrid.jumpToKey = [0, 0, 0, 0]
        end if
        return true
    end if
    return false
end function
