<component name="BookmarksScreen" extends="Group" includes="AutoBind,Focus,ContextMenuProvider">
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <field id="applicationInfo" type="node" bind="/ApplicationInfo" />
        <field id="bookmarksService" type="node" bind="/BookmarksService" />
        <function name="Refresh" />
    </interface>
    <children>
        <!-- YourTube: the app-wide empty state instead of three lines of text -->
        <Group id="noBookmarks" visible="false">
            <YourTubeEmptyState
                iconUri="pkg:/images/icons/ms/empty_bookmarks.png"
                title="No bookmarks yet"
                message="Long-press OK on any video, playlist or channel to bookmark it."
                focusable="false" />
        </Group>
        <Group id="yesBookmarks" visible="false">
            <VideoRowList
                itemComponentName="RowCell"
                id="rowList"
                translation="[0,50]"
                numRows="2"
                rowitemSize="[[350,196]]"
                rowItemSpacing="[[25,0]]"
                itemSize="[1280,326]"
                itemSpacing="[0,65]"
                rowLabelOffset="[[90,20]]"
                focusXOffset="[90]"
                showRowLabel="[true]"
                rowFocusAnimationStyle="floatingfocus"
                variableWidthItems="true"
                focusBitmapUri="pkg:/images/focus-glow-padding-30.$$RES$$.9.png" />
        </Group>
    </children>
</component>