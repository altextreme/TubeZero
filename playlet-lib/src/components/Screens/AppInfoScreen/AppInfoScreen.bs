import "pkg:/source/utils/Types.bs"

function Init()
    ' TODO:P2 Add tooltip to each field with description of what it means
    ' YourTube: YourTube labels; the "latest Playlet version" row is gone (no update checks against Playlet)
    m.displayNames = [{
        key: "app_version"
        displayText: "TubeZero Version"
    }, {
        key: "lib_version"
        displayText: "Library Version"
    }, {
        key: "lib_url"
        displayText: "Library URL"
    }, {
        key: "lib_url_type"
        displayText: "Library URL Type"
    }, {
        key: "app_git_commit_hash"
        displayText: "App Git Commit Hash"
    }, {
        key: "lib_git_commit_hash"
        displayText: "Library Git Commit Hash"
    }, {
        key: "id"
        displayText: "App ID"
    }]

    ' YourTube: AGPL-3.0 attribution
    m.credits = [
        ""
        "TubeZero is a personal fork of Playlet by Brahim Hadriche."
        "Playlet: github.com/iBicha/playlet. Licensed under the GNU AGPL-3.0."
        "TubeZero source: github.com/altextreme/TubeZero"
    ]

    m.keyValueList = m.top.findNode("KeyValueListContent")
end function

function OnNodeReady()
    m.appInfo = m.applicationInfo@.GetAppInfo()

    UpdateKeyValueList()

    if m.appInfo.lib_version_latest = "N/A"
        m.applicationInfo.ObserveFieldScoped("lib_version_latest", FuncName(OnAppInfoChanged))
    end if
end function

function OnAppInfoChanged()
    m.appInfo["lib_version_latest"] = m.applicationInfo.lib_version_latest
    UpdateKeyValueList()
end function

function UpdateKeyValueList()
    while m.keyValueList.getChildCount() > 0
        m.keyValueList.removeChildIndex(0)
    end while

    for each item in m.displayNames
        value = `${item.displayText}: ${m.appInfo[item.key]}`
        contentNode = m.keyValueList.createChild("ContentNode")
        contentNode.title = value
    end for

    ' YourTube: credits under the version info
    for each line in m.credits
        contentNode = m.keyValueList.createChild("ContentNode")
        contentNode.title = line
    end for
end function
