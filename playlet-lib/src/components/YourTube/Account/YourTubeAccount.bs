import "pkg:/components/Services/Innertube/Context.bs"
import "pkg:/components/YourTube/YourTubeJson.bs"
import "pkg:/source/services/HttpClient.bs"

' YourTube: InnerTube requests for account actions (see YourTubeAccountActionJob).
namespace YourTubeAccount

    ' { endpoint, body } for an action, or invalid for an unknown one. The body has no context yet.
    function ActionPayload(action as string, videoId as string) as dynamic
        if action = "like" or action = "dislike" or action = "removelike"
            return { endpoint: "like/" + action, body: { "target": { "videoId": videoId } } }
        else if action = "save"
            return { endpoint: "browse/edit_playlist", body: { "playlistId": "WL", "actions": [{ "action": "ACTION_ADD_VIDEO", "addedVideoId": videoId }] } }
        else if action = "subscribe" or action = "unsubscribe"
            return { endpoint: "subscription/" + action, body: { "channelIds": [videoId] } }
        else if action = "unsave"
            return { endpoint: "browse/edit_playlist", body: { "playlistId": "WL", "actions": [{ "action": "ACTION_REMOVE_VIDEO_BY_VIDEO_ID", "removedVideoId": videoId }] } }
        end if
        return invalid
    end function

    ' Your like and subscription state from a /next response (WEB or TV shape): the first likeStatus
    ' ("LIKE", "DISLIKE", "INDIFFERENT") and subscribed flag found. Unknown values come back as "" / invalid.
    function ParseVideoState(nextResponse as dynamic) as object
        state = { likeStatus: "", subscribed: invalid }
        if not YourTubeJson.IsAA(nextResponse)
            return state
        end if
        state.likeStatus = YourTubeJson.AsString(YourTubeJson.FindKey(nextResponse, "likeStatus", 0))
        subscribed = YourTubeJson.FindKey(nextResponse, "subscribed", 0)
        if subscribed = true or subscribed = false
            state.subscribed = subscribed
        end if
        return state
    end function

'' True when a browse response (your Watch Later playlist) lists videoId anywhere. TV responses nest
    ' deeply, so this searches further than YourTubeJson's helpers.
    function PlaylistHasVideo(response as dynamic, videoId as string, depth = 0 as integer) as boolean
        if depth > 40 or videoId = ""
            return false
        end if
        if YourTubeJson.IsAA(response)
            if YourTubeJson.AsString(response["videoId"]) = videoId
                return true
            end if
            for each key in response
                if PlaylistHasVideo(response[key], videoId, depth + 1)
                    return true
                end if
            end for
        else if YourTubeJson.IsArr(response)
            for each child in response
                if PlaylistHasVideo(child, videoId, depth + 1)
                    return true
                end if
            end for
        end if
        return false
    end function

    ' Your Watch Later playlist (first page) as the signed-in user.
    function CreateWatchLaterRequest() as object
        body = {
            "context": Innertube.CreateContext(Innertube.ClientType.Tv, CreateObject("roDeviceInfo"))
            "browseId": "VLWL"
        }
        request = HttpClient.Post("https://www.youtube.com/youtubei/v1/browse?prettyPrint=false&alt=json").JsonBody(body)
        request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Tv))
        return request
    end function

    ' /next as the signed-in user (TV client, like the other account calls).
    function CreateNextStateRequest(videoId as string) as object
        body = {
            "context": Innertube.CreateContext(Innertube.ClientType.Tv, CreateObject("roDeviceInfo"))
            "videoId": videoId
        }
        request = HttpClient.Post("https://www.youtube.com/youtubei/v1/next?prettyPrint=false&alt=json").JsonBody(body)
        request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Tv))
        return request
    end function

    function CreateActionRequest(action as string, videoId as string) as dynamic
        payload = ActionPayload(action, videoId)
        if payload = invalid
            return invalid
        end if
        body = payload.body
        body["context"] = Innertube.CreateContext(Innertube.ClientType.Tv, CreateObject("roDeviceInfo"))
        request = HttpClient.Post(`https://www.youtube.com/youtubei/v1/${payload.endpoint}?prettyPrint=false&alt=json`).JsonBody(body)
        request.Headers(Innertube.CreateHeaders(Innertube.ClientType.Tv))
        return request
    end function

end namespace
