import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/VideoFeed/FeedLoadState.bs"
import "pkg:/components/YourTube/FeedFilters/YourTubeFeedFilters.bs"
import "pkg:/source/utils/Types.bs"

' Fetch the next page when focus gets this many rows from the end
const GRID_LOAD_MORE_ROWS = 2
' Skeleton rows shown before the first page arrives
const GRID_PLACEHOLDER_ROWS = 2
' With a filter on, stop paging in after this many pages in a row added no matching card
const GRID_FILTER_MAX_EMPTY_PAGES = 4
' Height of the lead row (its title + cards)
const GRID_LEAD_ROW_HEIGHT = 330

function Init()
    m.feedNode = invalid
    m.gridJob = invalid
    ' Every card loaded so far, in order; the rows show the ones matching the filter
    m.allItems = []
    m.emptyFilterPages = 0
    m.leadNode = invalid
    m.leadJob = invalid
    m.gridRowHeights = invalid
end function

' Overrides VideoRowList.InitContent (runs on feeds change, Refresh and profile change).
function InitContent() as void
    CancelCurrentJobs()
    m.gridJob = invalid
    m.feedNode = invalid
    m.top.feedNode = invalid
    m.top.videoCount = 0
    m.allItems = []
    m.emptyFilterPages = 0
    m.leadNode = invalid
    m.leadJob = invalid
    SetLeadRowShown(false)

    root = CreateRoot()

    feeds = m.top.feeds
    profilesService = m.top.profilesService
    if not IsArray(feeds) or feeds.Count() = 0
        m.top.content = root
        m.top.feedState = "empty"
        return
    end if
    if m.top.requireSignIn and (profilesService = invalid or profilesService.currentProfile = invalid)
        m.top.content = root
        m.top.feedState = "signedOut"
        return
    end if

    feed = feeds[0]
    feedNode = CreateObject("roSGNode", "FeedContentNode")
    feedNode.title = ValidString(feed.title)
    feedNode.feedSourcesIndex = 0
    feedNode.loadState = FeedLoadState.None
    feedSources = ValidArray(feed.feedSources)
    for i = 0 to feedSources.Count() - 1
        feedSources[i].state = { loadState: FeedLoadState.None }
    end for
    feedNode.feedSources = feedSources
    m.feedNode = feedNode
    m.top.feedNode = feedNode

    for i = 1 to GRID_PLACEHOLDER_ROWS
        AppendLoadingRow(root)
    end for
    m.top.feedState = "loading"
    m.top.content = root
    LoadNextPage()
    LoadLeadRow()
end function

' YourTube: the lead row ("Live now") loads once with the feed through the same row job, then goes on top
' of the grid if it has cards.
function LoadLeadRow() as void
    leadFeed = m.top.leadFeed
    if not IsAssociativeArray(leadFeed) or not IsArray(leadFeed.feedSources) or leadFeed.feedSources.Count() = 0
        return
    end if
    leadNode = CreateObject("roSGNode", "FeedContentNode")
    leadNode.title = ValidString(leadFeed.title)
    leadNode.feedSourcesIndex = 0
    leadNode.loadState = FeedLoadState.None
    feedSources = leadFeed.feedSources
    for i = 0 to feedSources.Count() - 1
        feedSources[i].state = { loadState: FeedLoadState.None }
    end for
    leadNode.feedSources = feedSources
    m.leadNode = leadNode

    leadNode.loadState = FeedLoadState.Loading
    input = {
        rowList: m.top
        feedContentNode: leadNode
        invidious: m.top.invidious
    }
    callback = JobSystem.CreateCallback(OnLeadRowDone)
    m.leadJob = callback
    m.pendingLoadJobs[callback.id] = { callback: callback, content: leadNode }
    JobSystem.QueueJob(m.top.jobQueue, Jobs.VideoRowListRowContentJob, input, callback)
end function

function OnLeadRowDone(event as object) as void
    callback = event.getRoSGNode()
    JobSystem.UnobserveCallback(callback)
    m.pendingLoadJobs.Delete(callback.id)
    if m.leadJob = invalid or not callback.isSameNode(m.leadJob)
        return
    end if
    m.leadJob = invalid
    if event.getInfo().cancel = true or m.leadNode = invalid
        return
    end if
    ' The lead row is complete with its first page (no paging along it)
    m.leadNode.loadState = FeedLoadState.Loaded
    PlaceLeadRow(m.top.content)
end function

' Puts the loaded lead row first in root when it has cards and no filter is on.
function PlaceLeadRow(root as object) as void
    leadNode = m.leadNode
    show = root <> invalid and leadNode <> invalid and leadNode.getChildCount() > 0 and ValidString(m.top.filter) = ""
    if show
        first = root.getChild(0)
        if first = invalid or not first.isSameNode(leadNode)
            root.insertChild(leadNode, 0)
        end if
    end if
    SetLeadRowShown(show)
end function

' Titled, taller first row while the lead row shows; plain rows otherwise.
function SetLeadRowShown(shown as boolean) as void
    if m.gridRowHeights = invalid
        m.gridRowHeights = m.top.rowHeights
    end if
    gridRowHeight = 290
    if IsArray(m.gridRowHeights) and m.gridRowHeights.Count() > 0
        gridRowHeight = m.gridRowHeights[0]
    end if
    if shown
        m.top.rowLabelOffset = [[90, 0]]
        m.top.showRowLabel = [true, false]
        m.top.rowHeights = [GRID_LEAD_ROW_HEIGHT, gridRowHeight]
    else
        m.top.showRowLabel = [false]
        m.top.rowHeights = [gridRowHeight]
    end if
end function

function IsLeadRow(row as dynamic) as boolean
    return row <> invalid and m.leadNode <> invalid and row.isSameNode(m.leadNode)
end function

' Overrides VideoRowList.LoadRowsIfNeeded: page in more when focus nears the last rows.
function LoadRowsIfNeeded() as void
    root = m.top.content
    if m.feedNode = invalid or root = invalid or not m.top.visible
        return
    end if
    if m.feedNode.loadState <> FeedLoadState.LoadedPage
        return
    end if
    if m.emptyFilterPages >= GRID_FILTER_MAX_EMPTY_PAGES
        return
    end if
    focused = m.top.itemFocused
    if focused < 0
        focused = 0
    end if
    if focused >= root.getChildCount() - GRID_LOAD_MORE_ROWS
        AppendLoadingRow(root)
        LoadNextPage()
    end if
end function

' Overrides VideoRowList.OnRowItemFocused
function OnRowItemFocused(_event as object) as void
    LoadRowsIfNeeded()
end function

function LoadNextPage() as void
    if m.feedNode = invalid or m.gridJob <> invalid
        return
    end if
    loadState = m.feedNode.loadState
    if loadState = FeedLoadState.Loaded or loadState = FeedLoadState.Loading
        return
    end if

    m.feedNode.loadState = FeedLoadState.Loading
    input = {
        rowList: m.top
        feedContentNode: m.feedNode
        invidious: m.top.invidious
    }
    callback = JobSystem.CreateCallback(OnGridPageDone)
    m.gridJob = callback
    m.pendingLoadJobs[callback.id] = { callback: callback, content: m.feedNode }
    JobSystem.QueueJob(m.top.jobQueue, Jobs.VideoRowListRowContentJob, input, callback)
end function

function OnGridPageDone(event as object) as void
    callback = event.getRoSGNode()
    JobSystem.UnobserveCallback(callback)
    m.pendingLoadJobs.Delete(callback.id)
    if m.gridJob = invalid or not callback.isSameNode(m.gridJob)
        return
    end if
    m.gridJob = invalid
    info = event.getInfo()
    if info.cancel = true
        return
    end if

    feedNode = m.feedNode
    ' Still "Loading" when the job dropped the feed (not signed in / endpoint disabled) or threw: treat as done.
    if feedNode.loadState = FeedLoadState.Loading or feedNode.loadState = FeedLoadState.None
        feedNode.loadState = FeedLoadState.Loaded
    end if

    ' The job appends the new page to the (hidden) feed node; move those videos into rows of 4.
    items = []
    count = feedNode.getChildCount()
    if count > 0
        items = feedNode.getChildren(count, 0)
        feedNode.removeChildrenIndex(count, 0)
    end if
    shownBefore = m.top.videoCount
    AppendItems(items)
    if m.top.filter <> "" and m.top.videoCount = shownBefore
        m.emptyFilterPages += 1
    else
        m.emptyFilterPages = 0
    end if

    UpdateFeedState()

    ' Fill the screen (and keep going if the page was empty but more exist)
    LoadRowsIfNeeded()
end function

function UpdateFeedState() as void
    if m.top.videoCount > 0
        m.top.feedState = "ready"
    else if m.feedNode = invalid or m.feedNode.loadState = FeedLoadState.Loaded or m.emptyFilterPages >= GRID_FILTER_MAX_EMPTY_PAGES
        m.top.feedState = "empty"
    else
        m.top.feedState = "loading"
    end if
end function

function CreateRoot() as object
    root = CreateObject("roSGNode", "ContentNode")
    ' cards read their size from the content root (see YourTubeVideoCell.ApplyRowSize)
    root.addFields({ ytRowItemSize: m.top.rowItemSize })
    return root
end function

' YourTube: a new filter re-lays the loaded cards; paging continues (bounded) if too few match.
function OnFilterChange() as void
    if m.feedNode = invalid
        return
    end if
    m.emptyFilterPages = 0
    m.top.videoCount = 0
    root = CreateRoot()
    m.top.content = root
    PlaceItems(root, m.allItems)
    PlaceLeadRow(root)
    if m.feedNode.loadState = FeedLoadState.Loading
        AppendLoadingRow(root)
    end if
    UpdateFeedState()
    LoadRowsIfNeeded()
end function

function AppendItems(items as object) as void
    root = m.top.content
    if root = invalid
        return
    end if
    RemoveLoadingRows(root)
    m.allItems.Append(items)
    PlaceItems(root, items)
end function

function PlaceItems(root as object, items as object) as void
    filter = ValidString(m.top.filter)

    lastRow = invalid
    rowCount = root.getChildCount()
    if rowCount > 0
        lastRow = root.getChild(rowCount - 1)
    end if
    if IsLeadRow(lastRow)
        lastRow = invalid
    end if
    added = 0
    for each item in items
        if ValidString(item.type) = "loading" or not YourTubeFeedFilters.Matches(item, filter)
            continue for
        end if
        if lastRow = invalid or lastRow.getChildCount() >= GetColumns()
            lastRow = root.createChild("ContentNode")
        end if
        lastRow.appendChild(item)
        added += 1
    end for
    m.top.videoCount = m.top.videoCount + added
end function

function AppendLoadingRow(root as object) as void
    row = root.createChild("ContentNode")
    for i = 1 to GetColumns()
        row.createChild("LoadingContentNode")
    end for
end function

function RemoveLoadingRows(root as object) as void
    index = root.getChildCount() - 1
    while index >= 0
        row = root.getChild(index)
        first = row.getChild(0)
        if first <> invalid and ValidString(first.type) = "loading"
            root.removeChildIndex(index)
        end if
        index -= 1
    end while
end function

function GetColumns() as integer
    columns = m.top.columns
    if columns < 1
        columns = 1
    end if
    return columns
end function
