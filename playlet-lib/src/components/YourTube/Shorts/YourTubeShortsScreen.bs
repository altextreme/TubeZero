import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

' YourTube: Shorts tab. Playback reuses the shared VideoQueue/VideoPlayerDev: the container stays
' non-fullscreen (the player's PiP mode, so this screen keeps focus) and the player is moved onto the 9:16
' frame and flagged yourtubeShorts (loops, no PiP hint, no error dialog). Playback runs only while the screen
' holds focus: in the nav, Back would otherwise blow the Short up into the full player. On stop the player is
' closed, the Shorts are taken back out of the queue and the container's fullscreen flag is restored.

' The frame, in screen coordinates at rest (AppScreens slides right while the nav is open).
const FRAME_X = 456
const FRAME_Y = 40
const FRAME_W = 360
const FRAME_H = 640
' load more when this close to the end of the list
const PREFETCH_DISTANCE = 3
' consecutive Shorts that failed to play before giving up on auto-skipping
const MAX_FAILURES = 3
' YourTube: the action column's buttons (YourTubeShortsActions renders them in this order)
const ACTION_LIKE = 0
const ACTION_DISLIKE = 1
const ACTION_COMMENTS = 2
const ACTION_SUBSCRIBE = 3
const ACTION_COUNT = 4
' how far the stage (and the player on it) slides left while the comments panel is docked on the right
const COMMENTS_SHIFT = 400
' YourTube: the "From subscriptions" feed preference (also in Settings)
const SUBS_ONLY_PREF = "content_feed.shorts_subscriptions_only"

function Init()
    m.keySink = m.top.findNode("KeySink")
    m.stage = m.top.findNode("ShortsStage")
    m.messageState = m.top.findNode("MessageState")
    m.thumb = m.top.findNode("ShortThumb")
    m.preloadThumb = m.top.findNode("PreloadThumb")
    m.frameStatus = m.top.findNode("FrameStatus")
    m.channelLabel = m.top.findNode("ChannelLabel")
    m.titleLabel = m.top.findNode("TitleLabel")
    m.statsLabel = m.top.findNode("StatsLabel")
    m.playStateLabel = m.top.findNode("PlayStateLabel")
    m.keyHint = m.top.findNode("KeyHint")
    m.sideKeyHint = m.top.findNode("SideKeyHint")
    m.infoGroup = m.top.findNode("InfoGroup")
    m.sideHints = m.top.findNode("SideHints")
    m.actions = m.top.findNode("Actions")
    m.comments = m.top.findNode("ShortsComments")
    m.toast = m.top.findNode("ShortsToast")
    m.subsChip = m.top.findNode("SubsChip")
    m.subsChipRing = m.top.findNode("SubsChipRing")
    m.subsChipFill = m.top.findNode("SubsChipFill")
    m.subsChipIcon = m.top.findNode("SubsChipIcon")
    m.subsChipLabel = m.top.findNode("SubsChipLabel")
    m.subsChipHint = m.top.findNode("SubsChipHint")
    m.revealTimer = m.top.findNode("RevealTimer")
    m.skipTimer = m.top.findNode("SkipTimer")
    m.blurTimer = m.top.findNode("BlurTimer")

    m.shorts = []
    m.seenIds = {}
    m.index = -1
    m.continuation = ""
    m.loadJob = invalid
    m.loadError = ""
    m.infoJob = invalid
    m.infoJobVideoId = ""
    m.pendingAdvance = false

    m.hasFocus = false
    m.active = false
    m.player = invalid
    m.switching = false
    m.ownsContainer = false
    m.savedFullscreen = true
    m.savedQueueIndex = -1
    m.queuedIds = {}
    m.failures = 0

    ' "frame" (Up/Down = Shorts), "actions" (the button column) or "comments" (the panel has focus)
    m.focusArea = "frame"
    m.actionIndex = ACTION_LIKE
    m.frameShift = 0
    m.stateJob = invalid
    m.pendingActions = {}
    m.chipReturnArea = "frame"

    ' "subs" (seeded from your subscriptions' Shorts) or "all"; "" until the first load
    m.feedMode = ""
    m.feedDirty = false
    ' the subscription Shorts' ids: later batches are reel sequences seeded from these, in turn
    m.subsSeeds = []
    m.subsSeedIndex = 0
    ' how many Shorts at the start of the list came from the subscriptions feed itself
    m.subsCount = 0
    m.subsEndToastShown = false
    m.top.focusable = true
end function

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(invalid, RemoteKeys.Left, m.navBar)

    m.top.ObserveField("visible", FuncName(OnVisibleChange))
    m.top.ObserveField("focusedChild", FuncName(OnFocusedChildChange))
    m.revealTimer.ObserveField("fire", FuncName(RevealPlayer))
    m.skipTimer.ObserveField("fire", FuncName(OnSkipTimer))
    m.blurTimer.ObserveField("fire", FuncName(OnBlurTimer))
    m.messageState.ObserveField("selected", FuncName(OnRetrySelected))
    m.comments.ObserveField("closed", FuncName(OnCommentsClosed))
    if m.preferences <> invalid
        m.preferences.ObserveFieldScoped(SUBS_ONLY_PREF, FuncName(OnFeedSettingChange))
    end if
    if m.profilesService <> invalid
        m.profilesService.ObserveFieldScoped("currentProfile", FuncName(OnFeedSettingChange))
    end if
    RenderChip()
    m.videoQueue.ObserveField("player", FuncName(OnQueuePlayerChange))
    ' AppScreens slides right while the nav is open; the player (in the video container) has to follow
    m.screensContainer = m.top.getParent()
    if m.screensContainer <> invalid
        m.screensContainer.ObserveField("translation", FuncName(ApplyPlayerRect))
    end if

    OnVisibleChange()
end function

'-------------------------------------------------------------------------------
' Lifecycle: visible -> load + show the thumbnail; focused -> play; blurred or hidden -> stop.
'-------------------------------------------------------------------------------
function OnVisibleChange() as void
    if not m.top.visible
        StopPlayback()
        return
    end if
    if ShortsDisabled()
        ShowMessage("Shorts are turned off", "Turn off Disable Shorts in Settings to watch Shorts here.", "")
        return
    end if
    HideMessage()
    RenderChip()
    if m.feedDirty
        ResetFeed()
    else if m.shorts.Count() = 0
        LoadShorts()
    else
        ShowCurrent()
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    if m.messageState.visible and m.messageState.focusable
        NodeSetFocus(m.messageState, true)
    else
        NodeSetFocus(m.keySink, true)
    end if
end function

function OnFocusedChildChange() as void
    inChain = m.top.isInFocusChain()
    if inChain = m.hasFocus
        return
    end if
    m.hasFocus = inChain
    if inChain
        m.blurTimer.control = "stop"
        StartPlayback()
    else
        ' closing the player refocuses the top screen; deferred so that lands on the nav, not back here
        m.blurTimer.control = "start"
    end if
end function

function OnBlurTimer() as void
    if not m.top.isInFocusChain()
        StopPlayback()
    end if
end function

function ShortsDisabled() as boolean
    return m.preferences <> invalid and m.preferences["content_feed.disable_shorts"] = true
end function

function StartPlayback() as void
    if not m.top.visible or ShortsDisabled() or m.messageState.visible
        return
    end if
    if m.index < 0 or m.index >= m.shorts.Count()
        ' PlayIndex runs when the first batch arrives
        return
    end if
    if not m.active
        PlayIndex(m.index)
    end if
end function

function StopPlayback() as void
    ResetLayout()
    m.skipTimer.control = "stop"
    m.revealTimer.control = "stop"
    m.pendingAdvance = false
    wasActive = m.active
    m.active = false
    player = m.player
    m.player = invalid
    if player <> invalid
        player.UnobserveField("state")
    end if
    if not wasActive and not m.ownsContainer
        return
    end if

    queuePlayer = m.videoQueue.player
    if queuePlayer <> invalid and player <> invalid and queuePlayer.isSameNode(player)
        m.switching = true
        m.videoQueue.closePlayer = true
        m.switching = false
    end if
    RemoveShortsFromQueue()
    ReleaseContainer()
    m.playStateLabel.text = ""
end function

function TakeContainer() as void
    if m.ownsContainer
        return
    end if
    container = m.videoQueue.videoContainer
    m.savedFullscreen = container.fullscreen
    m.savedQueueIndex = m.videoQueue.index
    m.ownsContainer = true
    container.fullscreen = false
end function

function ReleaseContainer() as void
    if not m.ownsContainer
        return
    end if
    m.ownsContainer = false
    m.videoQueue.videoContainer.fullscreen = m.savedFullscreen
end function

' Every Short played was inserted into the shared queue (playVideo); take them back out.
function RemoveShortsFromQueue() as void
    if m.queuedIds.Count() = 0
        return
    end if
    content = m.videoQueue.content
    for i = content.getChildCount() - 1 to 0 step -1
        child = content.getChild(i)
        if child <> invalid and m.queuedIds.DoesExist(ValidString(child.videoId))
            content.removeChildIndex(i)
        end if
    end for
    m.queuedIds = {}
    count = content.getChildCount()
    index = m.savedQueueIndex
    if index >= count
        index = count - 1
    end if
    m.videoQueue.index = index
end function

'-------------------------------------------------------------------------------
' Playback of one Short.
'-------------------------------------------------------------------------------
function PlayIndex(index as integer) as void
    if index < 0 or index >= m.shorts.Count()
        return
    end if
    m.index = index
    ShowCurrent()
    if not m.hasFocus or not m.top.visible
        return
    end if
    ' YourTube: past the subscriptions feed's own Shorts, into sequences seeded from them
    if m.feedMode = "subs" and m.subsCount > 0 and index = m.subsCount and not m.subsEndToastShown
        m.subsEndToastShown = true
        m.toast.text = "That's all from your subscriptions. More like them next."
    end if

    item = m.shorts[index]
    TakeContainer()
    m.active = true
    m.skipTimer.control = "stop"
    if m.player <> invalid
        m.player.UnobserveField("state")
        m.player = invalid
    end if

    node = CreateObject("roSGNode", "VideoContentNode")
    node.type = "video"
    node.id = item.videoId
    node.videoId = item.videoId
    node.title = item.title
    node._author = item.channel
    node.thumbnail = item.thumbnail
    m.queuedIds[item.videoId] = true

    m.switching = true
    m.videoQueue.playVideo = node
    m.switching = false
    AdoptPlayer()
end function

function AdoptPlayer() as void
    player = m.videoQueue.player
    if player = invalid or not m.active
        return
    end if
    if m.player <> invalid and m.player.isSameNode(player)
        return
    end if
    m.player = player
    player.yourtubeShorts = true
    player.loop = true
    ' hidden until the first frame so the thumbnail shows while it loads (RevealTimer is the safety net)
    player.visible = false
    ApplyPlayerRect()
    player.ObserveField("state", FuncName(OnPlayerState))
    m.revealTimer.control = "stop"
    m.revealTimer.control = "start"
    m.playStateLabel.text = ""
end function

function ApplyPlayerRect() as void
    player = m.player
    if player = invalid
        return
    end if
    offsetX = 0
    if m.screensContainer <> invalid
        offsetX = m.screensContainer.translation[0]
    end if
    x = FRAME_X - m.frameShift + offsetX
    ' minRect too: the player sizes itself from it in OnNodeReady, which may still be ahead of it
    player.minRect = [x, FRAME_Y, FRAME_W, FRAME_H]
    player.width = FRAME_W
    player.height = FRAME_H
    player.translation = [x, FRAME_Y]
end function

function RevealPlayer() as void
    if m.player <> invalid
        m.player.visible = true
    end if
end function

function OnPlayerState(event as object) as void
    state = event.getData()
    if state = "playing"
        m.revealTimer.control = "stop"
        RevealPlayer()
        m.failures = 0
        m.playStateLabel.text = ""
        UpdateKeyHints()
    else if state = "paused"
        m.playStateLabel.text = "Paused"
        UpdateKeyHints()
    end if
end function

' The queue's player changed outside PlayIndex/StopPlayback: either our Short failed (the player closes
' itself in Shorts mode instead of showing a dialog) or something else (cast, web remote) started a video.
function OnQueuePlayerChange() as void
    if m.switching or not m.active
        return
    end if
    player = m.videoQueue.player
    if player = invalid
        if m.player <> invalid
            m.player.UnobserveField("state")
            m.player = invalid
            m.active = false
            OnShortFailed()
        end if
        return
    end if
    if m.player <> invalid and m.player.isSameNode(player)
        return
    end if
    ' someone else's video: hand the container back full screen and let it have the focus
    LogInfo("Shorts: another video took over the player")
    if m.player <> invalid
        m.player.UnobserveField("state")
        m.player = invalid
    end if
    m.active = false
    m.ownsContainer = false
    m.queuedIds = {}
    ResetLayout()
    m.videoQueue.videoContainer.fullscreen = true
    NodeSetFocus(player, true)
end function

function OnShortFailed() as void
    m.failures += 1
    m.thumb.uri = ""
    if m.failures >= MAX_FAILURES
        m.frameStatus.text = "Couldn't play this Short"
        m.playStateLabel.text = "Press Down to try the next one"
        return
    end if
    m.frameStatus.text = "Couldn't play this Short"
    m.skipTimer.control = "start"
end function

function OnSkipTimer() as void
    if m.hasFocus and m.top.visible
        MoveBy(1)
    end if
end function

function TogglePause() as void
    player = m.player
    if player = invalid
        return
    end if
    if player.state = "playing"
        player.control = "pause"
    else if player.state = "paused"
        player.control = "resume"
    end if
end function

function MoveBy(delta as integer) as void
    target = m.index + delta
    if target < 0
        return
    end if
    if target >= m.shorts.Count()
        ' at the end: play it as soon as the next batch lands
        m.pendingAdvance = true
        LoadMore()
        return
    end if
    if delta < 0
        m.failures = 0
    end if
    PlayIndex(target)
end function

'-------------------------------------------------------------------------------
' Info panel / thumbnail.
'-------------------------------------------------------------------------------
function ShowCurrent() as void
    if m.index < 0 or m.index >= m.shorts.Count()
        return
    end if
    item = m.shorts[m.index]
    m.frameStatus.text = ""
    m.thumb.uri = item.thumbnail
    m.titleLabel.text = item.title
    m.channelLabel.text = item.channel
    m.statsLabel.text = item.statsText
    m.playStateLabel.text = ""
    UpdateKeyHints()
    UpdateActions()
    LoadAccountState(item)
    if m.index + 1 < m.shorts.Count()
        m.preloadThumb.uri = m.shorts[m.index + 1].thumbnail
    end if
    if not item.infoLoaded
        LoadInfo(item.videoId)
    end if
    if m.shorts.Count() - m.index <= PREFETCH_DISTANCE
        LoadMore()
    end if
end function

function LoadInfo(videoId as string) as void
    if m.infoJob <> invalid
        if m.infoJobVideoId = videoId
            return
        end if
        JobSystem.UnobserveCallback(m.infoJob)
        m.infoJob.cancel = true
    end if
    m.infoJobVideoId = videoId
    m.infoJob = JobSystem.CreateCallback(OnInfoDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeShortsJob, { op: "info", videoId: videoId }, m.infoJob)
end function

function OnInfoDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    m.infoJob = invalid
    m.infoJobVideoId = ""
    info = event.getInfo()
    if not info.success
        return
    end if
    data = info.data
    for i = 0 to m.shorts.Count() - 1
        item = m.shorts[i]
        if item.videoId = data.videoId
            if ValidString(data.title) <> ""
                item.title = data.title
            end if
            if ValidString(data.channel) <> ""
                item.channel = data.channel
            end if
            if ValidString(data.statsText) <> ""
                item.statsText = data.statsText
            end if
            if ValidString(data.channelId) <> ""
                item.channelId = data.channelId
            end if
            item.likesText = ValidString(data.likesText)
            item.commentsText = ValidString(data.commentsText)
            item.infoLoaded = true
            if i = m.index
                m.titleLabel.text = item.title
                m.channelLabel.text = item.channel
                m.statsLabel.text = item.statsText
                UpdateActions()
            end if
            exit for
        end if
    end for
end function

'-------------------------------------------------------------------------------
' Sequence loading.
'-------------------------------------------------------------------------------
function LoadShorts() as void
    if m.loadJob <> invalid
        return
    end if
    m.thumb.uri = ""
    ' YourTube: Shorts from your subscriptions when that's on and you're signed in
    if DesiredFeedMode() = "subs"
        m.feedMode = "subs"
        m.frameStatus.text = "Loading Shorts from your subscriptions..."
        m.loadJob = JobSystem.CreateCallback(OnLoadDone)
        JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeShortsJob, { op: "subs", profile: CurrentProfile() }, m.loadJob)
        return
    end if
    LoadAllShorts()
end function

function LoadAllShorts() as void
    m.feedMode = "all"
    m.frameStatus.text = "Loading Shorts..."
    m.loadJob = JobSystem.CreateCallback(OnLoadDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeShortsJob, { op: "start" }, m.loadJob)
end function

function LoadMore() as void
    if m.loadJob <> invalid or m.shorts.Count() = 0
        return
    end if
    lastVideoId = m.shorts[m.shorts.Count() - 1].videoId
    continuation = m.continuation
    ' YourTube: subscriptions feed: only sequences seeded from your subscriptions' Shorts, each in turn
    if m.feedMode = "subs" and m.subsSeeds.Count() > 0
        lastVideoId = m.subsSeeds[m.subsSeedIndex mod m.subsSeeds.Count()]
        m.subsSeedIndex += 1
        continuation = ""
    end if
    m.loadJob = JobSystem.CreateCallback(OnLoadDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeShortsJob, { op: "more", continuation: continuation, lastVideoId: lastVideoId }, m.loadJob)
end function

function OnLoadDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    m.loadJob = invalid
    info = event.getInfo()
    wasEmpty = m.shorts.Count() = 0

    ' YourTube: no Shorts in your subscriptions feed (or it failed): fall back to the regular feed
    if wasEmpty and m.feedMode = "subs" and (not info.success or ValidArray(info.data.shorts).Count() = 0)
        LogWarn("Shorts: subscriptions feed empty or failed", info.error)
        m.toast.text = "No Shorts from your subscriptions right now"
        LoadAllShorts()
        return
    end if

    if not info.success
        LogWarn("Shorts: load failed", info.error)
        m.pendingAdvance = false
        if wasEmpty
            m.frameStatus.text = ""
            ShowMessage("Couldn't load Shorts", ValidString(info.error).Split(Chr(10))[0], "Try again")
        end if
        return
    end if

    data = info.data
    m.continuation = ValidString(data.continuation)
    added = 0
    for each entry in ValidArray(data.shorts)
        videoId = ValidString(entry.videoId)
        if videoId <> "" and not m.seenIds.DoesExist(videoId)
            m.seenIds[videoId] = true
            m.shorts.Push({
                videoId: videoId
                thumbnail: ValidString(entry.thumbnail)
                title: ValidString(entry.title)
                channel: ValidString(entry.channel)
                channelId: ValidString(entry.channelId)
                statsText: ValidString(entry.viewsText)
                likesText: ""
                commentsText: ""
                liked: false
                disliked: false
                subscribed: false
                stateLoaded: false
                infoLoaded: false
            })
            added += 1
        end if
    end for

    if m.shorts.Count() = 0
        ShowMessage("No Shorts right now", "Try again in a moment.", "Try again")
        return
    end if

    if wasEmpty
        if m.feedMode = "subs"
            m.subsCount = m.shorts.Count()
            m.subsSeeds = []
            for each item in m.shorts
                m.subsSeeds.Push(item.videoId)
            end for
        end if
        m.index = 0
        if m.hasFocus
            PlayIndex(0)
        else
            ShowCurrent()
        end if
        return
    end if

    if m.index + 1 < m.shorts.Count()
        m.preloadThumb.uri = m.shorts[m.index + 1].thumbnail
    end if
    if m.pendingAdvance
        m.pendingAdvance = false
        if added > 0
            MoveBy(1)
        end if
    end if
end function

'-------------------------------------------------------------------------------
' Message state (Shorts disabled / load error).
'-------------------------------------------------------------------------------
function ShowMessage(title as string, message as string, actionText as string) as void
    StopPlayback()
    m.focusArea = "frame"
    UpdateActions()
    UpdateKeyHints()
    RenderChip()
    m.stage.visible = false
    m.messageState.title = title
    m.messageState.message = message
    m.messageState.actionText = actionText
    m.messageState.visible = true
    if m.top.isInFocusChain()
        if actionText <> ""
            NodeSetFocus(m.messageState, true)
        else
            NodeSetFocus(m.keySink, true)
        end if
    end if
end function

function HideMessage() as void
    if not m.messageState.visible
        return
    end if
    focusWasHere = m.messageState.isInFocusChain()
    m.messageState.visible = false
    m.messageState.actionText = ""
    m.stage.visible = true
    if focusWasHere
        NodeSetFocus(m.keySink, true)
    end if
end function

function OnRetrySelected() as void
    HideMessage()
    ResetFeed()
end function

' YourTube: drop the list and start over (retry, or the feed source changed).
function ResetFeed() as void
    m.feedDirty = false
    StopPlayback()
    if m.loadJob <> invalid
        JobSystem.UnobserveCallback(m.loadJob)
        m.loadJob.cancel = true
        m.loadJob = invalid
    end if
    m.shorts = []
    m.seenIds = {}
    m.index = -1
    m.continuation = ""
    m.pendingAdvance = false
    m.subsSeeds = []
    m.subsSeedIndex = 0
    m.subsCount = 0
    m.subsEndToastShown = false
    m.thumb.uri = ""
    m.titleLabel.text = ""
    m.channelLabel.text = ""
    m.statsLabel.text = ""
    m.playStateLabel.text = ""
    UpdateActions()
    if m.top.visible and not ShortsDisabled()
        HideMessage()
        LoadShorts()
    end if
end function

'-------------------------------------------------------------------------------
' YourTube: "From subscriptions" feed chip.
'-------------------------------------------------------------------------------
function SubsOnlyPref() as boolean
    return m.preferences <> invalid and m.preferences[SUBS_ONLY_PREF] = true
end function

function DesiredFeedMode() as string
    if SubsOnlyPref() and IsYouTubeProfile(CurrentProfile())
        return "subs"
    end if
    return "all"
end function

' The preference (chip or Settings) or the signed-in profile changed.
function OnFeedSettingChange() as void
    RenderChip()
    if m.feedMode = "" or DesiredFeedMode() = m.feedMode
        return
    end if
    if m.top.visible
        ResetFeed()
    else
        m.feedDirty = true
    end if
end function

function ToggleSubsFeed() as void
    if not IsYouTubeProfile(CurrentProfile())
        m.toast.text = "Sign in with YouTube from Profile first"
        return
    end if
    turnOn = not SubsOnlyPref()
    if turnOn
        m.toast.text = "Shorts from your subscriptions"
    else
        m.toast.text = "All Shorts"
    end if
    ' saved by Preferences; OnFeedSettingChange reloads the feed
    m.preferences.setField(SUBS_ONLY_PREF, turnOn)
end function

function RenderChip() as void
    signedIn = IsYouTubeProfile(CurrentProfile())
    isOn = SubsOnlyPref() and signedIn
    focused = m.focusArea = "chip"

    m.subsChipLabel.text = "From subscriptions"
    width = m.subsChipLabel.localBoundingRect().width + 58
    m.subsChipFill.width = width
    m.subsChipRing.width = width + 6
    m.subsChipRing.visible = focused
    if isOn
        m.subsChipFill.color = "#EBEBEBFF"
        m.subsChipLabel.color = "#161616FF"
        m.subsChipIcon.blendColor = "#161616FF"
    else
        m.subsChipFill.color = "#272727FF"
        m.subsChipLabel.color = "#AAAAAAFF"
        m.subsChipIcon.blendColor = "#AAAAAAFF"
    end if
    if signedIn
        m.subsChip.opacity = 1.0
    else
        m.subsChip.opacity = 0.6
    end if

    hint = ""
    if focused
        if not signedIn
            hint = "Sign in with YouTube from Profile to watch Shorts from your subscriptions"
        else if isOn
            hint = "OK  Show all Shorts"
        else
            hint = "OK  Only Shorts from your subscriptions"
        end if
    end if
    m.subsChipHint.text = hint
end function

function OnChipKey(key as string) as boolean
    if key = RemoteKeys.Down or key = RemoteKeys.Back
        SetFocusArea(m.chipReturnArea)
        return true
    else if key = RemoteKeys.Ok
        ToggleSubsFeed()
        return true
    else if key = RemoteKeys.Up or key = RemoteKeys.Right
        return true
    end if
    return false
end function

'-------------------------------------------------------------------------------
' Keys.
'-------------------------------------------------------------------------------
function OnKeyEvent(key as string, press as boolean) as boolean
    ' Options (press and release) would toggle the player to full screen in AppController: keep it here
    if key = RemoteKeys.Options
        return true
    end if
    ' YourTube: the action column handles its own Left/Back (back to the frame) ahead of the nav's
    if press and m.focusArea = "actions" and not m.messageState.visible
        return OnActionsKey(key)
    end if
    ' YourTube: the header chip; Left still goes to the nav (leaving the chip behind)
    if press and m.focusArea = "chip" and not m.messageState.visible
        if key <> RemoteKeys.Left
            return OnChipKey(key)
        end if
        m.focusArea = m.chipReturnArea
        RenderChip()
        UpdateActions()
        UpdateKeyHints()
    end if
    if NavigationKeyHandler(key, press).handled
        return true
    end if
    if not press
        return false
    end if
    if m.messageState.visible
        return key = RemoteKeys.Up or key = RemoteKeys.Down or key = RemoteKeys.Right
    end if
    if key = RemoteKeys.Up
        ' YourTube: Up from the first Short reaches the header chip
        if m.index <= 0
            SetFocusArea("chip")
        else
            MoveBy(-1)
        end if
        return true
    else if key = RemoteKeys.Down
        MoveBy(1)
        return true
    else if key = RemoteKeys.Ok
        TogglePause()
        return true
    else if key = RemoteKeys.Right
        ' YourTube: into the action column
        if CurrentItem() <> invalid
            SetFocusArea("actions")
        end if
        return true
    end if
    return false
end function

function OnActionsKey(key as string) as boolean
    if key = RemoteKeys.Left or key = RemoteKeys.Back
        SetFocusArea("frame")
        return true
    else if key = RemoteKeys.Up
        if m.actionIndex > 0
            m.actionIndex -= 1
            UpdateActions()
        else
            SetFocusArea("chip")
        end if
        return true
    else if key = RemoteKeys.Down
        if m.actionIndex < ACTION_COUNT - 1
            m.actionIndex += 1
            UpdateActions()
        end if
        return true
    else if key = RemoteKeys.Ok
        ActivateAction(m.actionIndex)
        return true
    else if key = RemoteKeys.Right
        return true
    end if
    return false
end function

'-------------------------------------------------------------------------------
' YourTube: action column (like / dislike / comments / subscribe).
'-------------------------------------------------------------------------------
function SetFocusArea(area as string) as void
    if area = "chip" and m.focusArea <> "chip"
        m.chipReturnArea = m.focusArea
    end if
    m.focusArea = area
    NodeSetFocus(m.keySink, true)
    UpdateActions()
    UpdateKeyHints()
    RenderChip()
end function

function UpdateKeyHints() as void
    if m.focusArea = "actions"
        m.keyHint.text = "OK  Select"
        m.sideKeyHint.text = "Left  Back to the Short"
        return
    end if
    state = ""
    if m.player <> invalid
        state = m.player.state
    end if
    if state = "playing"
        m.keyHint.text = "OK  Pause"
    else if state = "paused"
        m.keyHint.text = "OK  Play"
    else
        m.keyHint.text = "OK  Pause / play"
    end if
    m.sideKeyHint.text = "Right  Like, comments"
end function

function CurrentItem() as dynamic
    if m.index < 0 or m.index >= m.shorts.Count()
        return invalid
    end if
    return m.shorts[m.index]
end function

function UpdateActions() as void
    item = CurrentItem()
    focusIndex = -1
    if m.focusArea = "actions"
        focusIndex = m.actionIndex
    else if m.focusArea = "comments"
        focusIndex = ACTION_COMMENTS
    end if
    if item = invalid
        m.actions.likeText = ""
        m.actions.commentsText = ""
        m.actions.liked = false
        m.actions.disliked = false
        m.actions.subscribed = false
    else
        m.actions.likeText = item.likesText
        m.actions.commentsText = item.commentsText
        m.actions.liked = item.liked
        m.actions.disliked = item.disliked
        m.actions.subscribed = item.subscribed
    end if
    m.actions.focusIndex = focusIndex
end function

function CurrentProfile() as dynamic
    if m.profilesService = invalid
        return invalid
    end if
    return m.profilesService.currentProfile
end function

function IsYouTubeProfile(profile as dynamic) as boolean
    return profile <> invalid and profile.type = "youtube"
end function

' Your like / subscribe state for a Short, once per Short (signed in only).
function LoadAccountState(item as object) as void
    if item.stateLoaded
        return
    end if
    profile = CurrentProfile()
    if not IsYouTubeProfile(profile)
        return
    end if
    if m.stateJob <> invalid
        JobSystem.UnobserveCallback(m.stateJob)
        m.stateJob.cancel = true
    end if
    m.stateJob = JobSystem.CreateCallback(OnAccountStateLoaded)
    JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeVideoStateJob, { videoId: item.videoId, profile: profile }, m.stateJob)
end function

function OnAccountStateLoaded(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    m.stateJob = invalid
    info = event.getInfo()
    if not info.success
        return
    end if
    data = info.data
    videoId = ValidString(data.videoId)
    for each item in m.shorts
        if item.videoId = videoId
            item.stateLoaded = true
            item.liked = data.likeStatus = "LIKE"
            item.disliked = data.likeStatus = "DISLIKE"
            if data.subscribed = true or data.subscribed = false
                item.subscribed = data.subscribed
            end if
            exit for
        end if
    end for
    UpdateActions()
end function

function ActivateAction(index as integer) as void
    item = CurrentItem()
    if item = invalid
        return
    end if
    if index = ACTION_COMMENTS
        OpenComments(item)
        return
    end if
    profile = CurrentProfile()
    if not IsYouTubeProfile(profile)
        m.toast.text = "Sign in with YouTube from Profile first"
        return
    end if

    previous = { liked: item.liked, disliked: item.disliked, subscribed: item.subscribed }
    targetId = item.videoId
    action = ""
    message = ""
    if index = ACTION_LIKE
        if item.liked
            action = "removelike"
            message = "Like removed"
        else
            action = "like"
            message = "Liked"
        end if
        item.liked = not item.liked
        item.disliked = false
    else if index = ACTION_DISLIKE
        if item.disliked
            action = "removelike"
            message = "Dislike removed"
        else
            action = "dislike"
            message = "Disliked"
        end if
        item.disliked = not item.disliked
        item.liked = false
    else if index = ACTION_SUBSCRIBE
        targetId = ValidString(item.channelId)
        if targetId = ""
            m.toast.text = "Couldn't find this Short's channel"
            return
        end if
        if item.subscribed
            action = "unsubscribe"
            message = "Unsubscribed"
        else
            action = "subscribe"
            message = "Subscribed"
        end if
        item.subscribed = not item.subscribed
    end if
    if action = ""
        return
    end if
    m.toast.text = message
    UpdateActions()

    callback = JobSystem.CreateCallback(OnAccountActionDone)
    m.pendingActions[callback.id] = { videoId: item.videoId, previous: previous }
    JobSystem.QueueJob(m.jobQueue, Jobs.YourTubeAccountActionJob, { action: action, videoId: targetId, profile: profile }, callback)
end function

' The buttons flip right away; a failed request flips them back.
function OnAccountActionDone(event as object) as void
    callback = event.getRoSGNode()
    JobSystem.UnobserveCallback(callback)
    pending = m.pendingActions[callback.id]
    m.pendingActions.Delete(callback.id)
    if event.getInfo().success or pending = invalid
        return
    end if
    for each item in m.shorts
        if item.videoId = pending.videoId
            item.liked = pending.previous.liked
            item.disliked = pending.previous.disliked
            item.subscribed = pending.previous.subscribed
            exit for
        end if
    end for
    UpdateActions()
    m.toast.text = "Couldn't update your account. Try again."
end function

' The comments panel docks on the right; the stage (and the player on it) slides left out of its way.
function OpenComments(item as object) as void
    m.frameShift = COMMENTS_SHIFT
    m.stage.translation = [-COMMENTS_SHIFT, 0]
    m.infoGroup.visible = false
    m.sideHints.visible = false
    ApplyPlayerRect()
    m.focusArea = "comments"
    UpdateActions()
    m.comments.jobQueue = m.jobQueue
    m.comments.visible = true
    ' the panel takes focus itself; it's inside this screen, so playback keeps going
    m.comments.videoId = item.videoId
end function

function OnCommentsClosed() as void
    ResetLayout()
    SetFocusArea("actions")
end function

' Comments closed (or the screen is letting go of the player): stage back in place.
function ResetLayout() as void
    if m.comments.visible
        m.comments.visible = false
    end if
    if m.focusArea = "comments"
        m.focusArea = "actions"
        m.actionIndex = ACTION_COMMENTS
    end if
    if m.frameShift = 0
        return
    end if
    m.frameShift = 0
    m.stage.translation = [0, 0]
    m.infoGroup.visible = true
    m.sideHints.visible = true
    ApplyPlayerRect()
end function
