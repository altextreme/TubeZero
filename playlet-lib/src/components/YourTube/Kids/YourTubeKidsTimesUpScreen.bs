import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

' TubeZero Kids: see YourTubeKidsTimesUpScreen.xml

function Init()
    m.top.focusable = true
    m.parentPill = m.top.findNode("ParentPill")
    m.parentPill.observeField("selected", FuncName(OnParentSelected))
    m.dayTimer = m.top.findNode("DayTimer")
    m.dayTimer.observeField("fire", FuncName(OnDayTimer))
    m.dayTimer.control = "start"
end function

function OnParentSelected() as void
    service = m.global.yourtubeKids
    if service <> invalid
        service@.OpenParentMenu()
    end if
end function

' A new day ends the block. (More time from the parent menu closes this screen right away.)
function OnDayTimer() as void
    service = m.global.yourtubeKids
    if service = invalid or service@.IsTimeUp()
        return
    end if
    m.dayTimer.control = "stop"
    appController = service.appController
    stack = appController.stack
    if stack <> invalid and stack.getChildCount() > 0 and stack.getChild(stack.getChildCount() - 1).isSameNode(m.top)
        appController@.PopScreen()
    else if m.top.getParent() <> invalid
        m.top.getParent().removeChild(m.top)
    end if
end function

function OnFocusChange() as void
    if m.top.focus
        NodeSetFocus(m.parentPill, true)
    end if
end function

' Nothing else reacts while time is up; Back still reaches the app's exit dialog.
function OnKeyEvent(key as string, _press as boolean) as boolean
    if key = RemoteKeys.Back
        return false
    end if
    return true
end function
