<!--
    YourTube: video card styled after the YouTube TV app. Drop-in replacement for
    VideoRowCell inside RowCell (same itemContent contract), plus RowList focus fields.
-->
<component name="YourTubeVideoCell" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnContentSet" />
        <field id="type" type="string" value="video" />
        <!-- RowList focus fields, aliased from RowCell; unused while cards don't scale on focus -->
        <field id="focusPercent" type="float" />
        <field id="rowListHasFocus" type="boolean" />
        <field id="percentDurationWatched" type="float" onChange="OnPercentDurationWatched" />
    </interface>
    <children>
        <Font id="BadgeFont" uri="font:MediumSystemFontFile" size="15" />

        <Group id="Card">
            <Poster
                id="Thumbnail"
                width="350"
                height="196"
                loadDisplayMode="scaleToZoom"
                failedBitmapUri="pkg:/images/thumbnail-missing.jpg" />
            <Rectangle
                id="ProgressTrack"
                width="350"
                height="4"
                color="#717171"
                translation="[0,192]"
                visible="false" />
            <Rectangle
                id="ProgressBar"
                width="350"
                height="4"
                color="#FF0000"
                translation="[0,192]"
                scale="[0,1]" />
            <Poster
                id="CornerMask"
                width="350"
                height="196"
                uri="pkg:/images/yt-card-mask.$$RES$$.9.png" />
            <RoundedRect
                id="DurationBadge"
                height="24"
                color="#000000"
                opacity="0.7"
                visible="false">
                <Label
                    id="DurationLabel"
                    height="24"
                    color="#FFFFFF"
                    vertAlign="center"
                    translation="[7,0]" />
            </RoundedRect>
        </Group>

        <LayoutGroup
            id="TextGroup"
            translation="[0,218]"
            itemSpacings="[6,2]">
            <Label
                id="TitleLabel"
                width="350"
                color="#F1F1F1"
                maxLines="2"
                wrap="true">
                <Font role="font" uri="font:BoldSystemFontFile" size="20" />
            </Label>
            <Label
                id="ChannelLabel"
                width="350"
                color="#AAAAAA">
                <Font role="font" uri="font:SystemFontFile" size="16" />
            </Label>
            <!-- chips ("4K", "CC") then "views · age", like the YouTube TV card; placed in code -->
            <Group id="StatsRow">
                <RoundedRect id="Chip0" height="20" color="#3F3F3F" visible="false">
                    <Label id="ChipLabel0" height="20" color="#AAAAAA" vertAlign="center" translation="[5,0]">
                        <Font role="font" uri="font:MediumSystemFontFile" size="12" />
                    </Label>
                </RoundedRect>
                <RoundedRect id="Chip1" height="20" color="#3F3F3F" visible="false">
                    <Label id="ChipLabel1" height="20" color="#AAAAAA" vertAlign="center" translation="[5,0]">
                        <Font role="font" uri="font:MediumSystemFontFile" size="12" />
                    </Label>
                </RoundedRect>
                <RoundedRect id="Chip2" height="20" color="#3F3F3F" visible="false">
                    <Label id="ChipLabel2" height="20" color="#AAAAAA" vertAlign="center" translation="[5,0]">
                        <Font role="font" uri="font:MediumSystemFontFile" size="12" />
                    </Label>
                </RoundedRect>
                <Label
                    id="StatsLabel"
                    width="350"
                    color="#AAAAAA">
                    <Font role="font" uri="font:SystemFontFile" size="16" />
                </Label>
            </Group>
        </LayoutGroup>
    </children>
</component>
