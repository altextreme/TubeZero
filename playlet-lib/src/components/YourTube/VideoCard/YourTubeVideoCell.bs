import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/Types.bs"

const BADGE_INSET = 6

function Init()
    m.thumbnail = m.top.findNode("Thumbnail")
    m.titleLabel = m.top.findNode("TitleLabel")
    m.channelLabel = m.top.findNode("ChannelLabel")
    m.statsLabel = m.top.findNode("StatsLabel")
    m.durationBadge = m.top.findNode("DurationBadge")
    m.durationLabel = m.top.findNode("DurationLabel")
    m.durationLabel.font = m.top.findNode("BadgeFont")
    m.progressBar = m.top.findNode("ProgressBar")
    m.progressTrack = m.top.findNode("ProgressTrack")
    m.cornerMask = m.top.findNode("CornerMask")
    m.textGroup = m.top.findNode("TextGroup")
    m.size = [350, 196]
end function

' Rows can ask for bigger cards (Home's first shelf is 480x270): take the size from the
' parent RowList's rowItemSize for this card's row.
function ApplyRowSize(content as object) as void
    if m.rowList = invalid
        node = m.top.getParent()
        while node <> invalid and node.subtype() <> "VideoRowList"
            node = node.getParent()
        end while
        if node = invalid
            return
        end if
        m.rowList = node
    end if

    sizes = m.rowList.rowItemSize
    if not IsArray(sizes) or sizes.Count() = 0
        return
    end if
    rowIndex = 0
    row = content.getParent()
    root = m.rowList.content
    if row <> invalid and root <> invalid
        for i = 0 to root.getChildCount() - 1
            if root.getChild(i).isSameNode(row)
                rowIndex = i
                exit for
            end if
        end for
    end if
    size = sizes[MathUtils.Min(rowIndex, sizes.Count() - 1)]
    if not IsArray(size) or size.Count() < 2
        return
    end if
    SetSize(size[0], size[1])
end function

function SetSize(width as float, height as float) as void
    if m.size[0] = width and m.size[1] = height
        return
    end if
    m.size = [width, height]
    m.thumbnail.width = width
    m.thumbnail.height = height
    m.cornerMask.width = width
    m.cornerMask.height = height
    m.progressTrack.width = width
    m.progressBar.width = width
    m.progressTrack.translation = [0, height - 4]
    m.progressBar.translation = [0, height - 4]
    m.titleLabel.width = width
    m.channelLabel.width = width
    m.textGroup.translation = [0, height + 22]
end function

function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    ApplyRowSize(content)

    lines = content.lines
    if not IsArray(lines)
        lines = []
    end if

    m.titleLabel.text = ValidString(content.title)

    ' NOTE: "_author" not "author". See PlaylistContentNode.xml for explanation.
    channel = ValidString(content._author)
    if channel = "" and lines.Count() > 0
        channel = ValidString(lines[0])
    end if
    m.channelLabel.text = channel

    stats = BuildStatsLine(content)
    if stats = "" and lines.Count() > 1
        stats = ValidString(lines[1])
    end if
    m.statsLabel.text = stats
    ShowChips(content.badges)

    m.thumbnail.uri = ValidString(content.thumbnail)
    m.top.percentDurationWatched = ValidFloat(content.percentDurationWatched)

    lengthText = ValidString(content.lengthText)
    if lengthText <> ""
        ShowBadge(lengthText, "#161616FF", 0.7)
    else if content.isUpcoming = true
        ShowBadge(Tr(Locale.RowCell.Upcoming), "#161616FF", 0.7)
    else if content.liveNow = true
        ShowBadge(Tr(Locale.RowCell.Live), "#CC0000FF", 1.0)
    else
        m.durationBadge.visible = false
    end if
end function

' "28K views · 3 years ago" (or the premiere time for upcoming videos)
function BuildStatsLine(content as object) as string
    if content.isUpcoming = true
        return ValidString(content.premiereTimestampText)
    end if

    parts = []
    for each value in [content.viewCountText, content.publishedText]
        text = ValidString(value)
        if text <> ""
            parts.push(text)
        end if
    end for
    return parts.Join(" · ")
end function

' Up to three chips before the stats text; the text keeps whatever width is left.
function ShowChips(badges as dynamic) as void
    if not IsArray(badges)
        badges = []
    end if
    used = 0
    for i = 0 to 2
        chip = m.top.findNode("Chip" + i.ToStr())
        if i < badges.Count() and IsString(badges[i])
            label = m.top.findNode("ChipLabel" + i.ToStr())
            label.text = badges[i]
            chip.width = label.localBoundingRect().width + 10
            chip.visible = true
            used += chip.width + 6
        else
            chip.visible = false
        end if
    end for
    m.statsLabel.width = MathUtils.Max(m.size[0] - used, 0)
end function

function ShowBadge(text as string, color as string, opacity as float) as void
    m.durationLabel.text = text
    width = m.durationLabel.localBoundingRect().width + 14
    height = m.durationBadge.height
    m.durationBadge.width = width
    m.durationBadge.color = color
    m.durationBadge.opacity = opacity
    m.durationBadge.translation = [m.thumbnail.width - width - BADGE_INSET, m.thumbnail.height - height - BADGE_INSET]
    m.durationBadge.visible = true
end function

function OnPercentDurationWatched() as void
    percent = MathUtils.Clamp(m.top.percentDurationWatched, 0, 100) / 100.0
    m.progressBar.scale = [percent, 1]
    m.progressTrack.visible = percent > 0
end function
