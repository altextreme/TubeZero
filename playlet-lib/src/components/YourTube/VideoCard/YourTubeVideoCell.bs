import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/Types.bs"

const BADGE_INSET = 6

function Init()
    m.thumbnail = m.top.findNode("Thumbnail")
    m.titleLabel = m.top.findNode("TitleLabel")
    m.channelLabel = m.top.findNode("ChannelLabel")
    m.statsLabel = m.top.findNode("StatsLabel")
    m.durationBadge = m.top.findNode("DurationBadge")
    m.durationLabel = m.top.findNode("DurationLabel")
    m.durationLabel.font = m.top.findNode("BadgeFont")
    m.progressBar = m.top.findNode("ProgressBar")
    m.progressTrack = m.top.findNode("ProgressTrack")
end function

function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    lines = content.lines
    if not IsArray(lines)
        lines = []
    end if

    m.titleLabel.text = ValidString(content.title)

    ' NOTE: "_author" not "author". See PlaylistContentNode.xml for explanation.
    channel = ValidString(content._author)
    if channel = "" and lines.Count() > 0
        channel = ValidString(lines[0])
    end if
    m.channelLabel.text = channel

    stats = BuildStatsLine(content)
    if stats = "" and lines.Count() > 1
        stats = ValidString(lines[1])
    end if
    m.statsLabel.text = stats

    m.thumbnail.uri = ValidString(content.thumbnail)
    m.top.percentDurationWatched = ValidFloat(content.percentDurationWatched)

    lengthText = ValidString(content.lengthText)
    if lengthText <> ""
        ShowBadge(lengthText, "#161616FF", 0.7)
    else if content.isUpcoming = true
        ShowBadge(Tr(Locale.RowCell.Upcoming), "#161616FF", 0.7)
    else if content.liveNow = true
        ShowBadge(Tr(Locale.RowCell.Live), "#CC0000FF", 1.0)
    else
        m.durationBadge.visible = false
    end if
end function

' "28K views · 3 years ago" (or the premiere time for upcoming videos)
function BuildStatsLine(content as object) as string
    if content.isUpcoming = true
        return ValidString(content.premiereTimestampText)
    end if

    parts = []
    for each value in [content.viewCountText, content.publishedText]
        text = ValidString(value)
        if text <> ""
            parts.push(text)
        end if
    end for
    return parts.Join(" · ")
end function

function ShowBadge(text as string, color as string, opacity as float) as void
    m.durationLabel.text = text
    width = m.durationLabel.localBoundingRect().width + 14
    height = m.durationBadge.height
    m.durationBadge.width = width
    m.durationBadge.color = color
    m.durationBadge.opacity = opacity
    m.durationBadge.translation = [m.thumbnail.width - width - BADGE_INSET, m.thumbnail.height - height - BADGE_INSET]
    m.durationBadge.visible = true
end function

function OnPercentDurationWatched() as void
    percent = MathUtils.Clamp(m.top.percentDurationWatched, 0, 100) / 100.0
    m.progressBar.scale = [percent, 1]
    m.progressTrack.visible = percent > 0
end function
