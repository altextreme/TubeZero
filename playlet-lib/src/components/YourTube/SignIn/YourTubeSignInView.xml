<!--
    YourTube: full-screen "Sign in to YouTube" page (replaces the cramped YouTubeLoginDialog look). Same contract
    as that dialog for YouTubeLoginJob (it sets `url` and `code`), shown through YourTubeDialogHost like
    YourTubeDialog (close / wasClosed / returnFocus / FocusButtons).
-->
<component name="YourTubeSignInView" extends="Group" includes="AutoBind">
    <interface>
        <field id="profilesService" type="node" bind="/ProfilesService" />
        <field id="appController" type="node" bind="/AppController" />
        <field id="jobQueue" type="node" bind="/JobQueue" />
        <field id="code" type="string" onChange="OnCodeSet" />
        <field id="url" type="string" onChange="OnUrlSet" />
        <field id="alwaysOnTop" type="boolean" />
        <field id="wasClosed" type="boolean" alwaysNotify="true" />
        <field id="close" type="boolean" alwaysNotify="true" onChange="OnClose" />
        <field id="returnFocus" type="node" />
        <function name="FocusButtons" />
    </interface>
    <children>
        <Rectangle width="1280" height="720" color="0x0F0F0FFF" />
        <Poster uri="pkg:/images/logo-dark.png" width="160" height="63" translation="[56,36]" />

        <!-- left column: title and the two steps -->
        <Label text="Sign in to YouTube" color="0xF1F1F1FF" translation="[96,150]">
            <Font role="font" uri="font:BoldSystemFontFile" size="40" />
        </Label>
        <Label
            text="Use your phone or computer to finish signing in. Your likes, subscriptions, history and playlists come with you."
            width="600"
            wrap="true"
            color="0xAAAAAAFF"
            translation="[96,208]">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>

        <Group translation="[96,300]">
            <Poster uri="pkg:/images/yt-pill-dark.$$RES$$.9.png" width="40" height="40" />
            <Label text="1" width="40" height="40" horizAlign="center" vertAlign="center" color="0xF1F1F1FF">
                <Font role="font" uri="font:MediumSystemFontFile" size="20" />
            </Label>
            <Label text="On your phone or computer, go to" color="0xAAAAAAFF" translation="[60,0]">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>
            <Label text="yt.be/activate" color="0x3EA6FFFF" translation="[60,28]">
                <Font role="font" uri="font:MediumSystemFontFile" size="34" />
            </Label>
        </Group>

        <Group translation="[96,410]">
            <Poster uri="pkg:/images/yt-pill-dark.$$RES$$.9.png" width="40" height="40" />
            <Label text="2" width="40" height="40" horizAlign="center" vertAlign="center" color="0xF1F1F1FF">
                <Font role="font" uri="font:MediumSystemFontFile" size="20" />
            </Label>
            <Label text="Enter this code" color="0xAAAAAAFF" translation="[60,0]">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>
            <Poster
                id="CodeBox"
                uri="pkg:/images/yt-rounded.$$RES$$.9.png"
                blendColor="0x272727FF"
                width="420"
                height="84"
                translation="[60,34]">
                <Label
                    id="CodeLabel"
                    text="Getting a code..."
                    width="420"
                    height="84"
                    horizAlign="center"
                    vertAlign="center"
                    color="0xF1F1F1FF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="44" />
                </Label>
            </Poster>
        </Group>

        <Label
            text="This screen moves on by itself once you approve the sign-in."
            color="0x717171FF"
            translation="[96,566]">
            <Font role="font" uri="font:SystemFontFile" size="16" />
        </Label>

        <Poster
            id="CancelButton"
            uri="pkg:/images/yt-pill-light.$$RES$$.9.png"
            height="48"
            width="140"
            translation="[96,604]">
            <Label
                text="Cancel"
                width="140"
                height="48"
                horizAlign="center"
                vertAlign="center"
                color="0x0F0F0FFF">
                <Font role="font" uri="font:MediumSystemFontFile" size="18" />
            </Label>
        </Poster>

        <!-- right column: QR -->
        <Rectangle width="1" height="420" color="0x3F3F3FFF" translation="[786,170]" />
        <Label text="Or scan with your phone" width="340" horizAlign="center" color="0xF1F1F1FF" translation="[836,176]">
            <Font role="font" uri="font:MediumSystemFontFile" size="20" />
        </Label>
        <QrCodePoster
            id="QrCodePoster"
            width="300"
            height="300"
            loadWidth="300"
            loadHeight="300"
            padding="16"
            translation="[856,222]" />
        <Label text="Opens yt.be/activate with your code filled in" width="340" horizAlign="center" wrap="true" color="0x717171FF" translation="[836,540]">
            <Font role="font" uri="font:SystemFontFile" size="16" />
        </Label>
    </children>
</component>
