import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.list = m.top.findNode("StreamList")
    m.emptyState = m.top.findNode("EmptyState")
    m.hint = m.top.findNode("Hint")
    m.qrCode = m.top.findNode("QrCode")
    m.phoneUrl = m.top.findNode("PhoneUrl")
    m.items = []
end function

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(invalid, RemoteKeys.Left, m.navBar)

    m.live = m.global.yourtubeLive
    m.live.ObserveFieldScoped("recent", FuncName(Rebuild))
    m.live.ObserveFieldScoped("favorites", FuncName(Rebuild))
    m.list.ObserveField("itemSelected", FuncName(OnItemSelected))

    address = m.webServer@.GetServerAddress()
    if not StringUtils.IsNullOrEmpty(address)
        m.qrCode.text = address + "/live"
        m.phoneUrl.text = address + "/live"
    end if
    Rebuild()
end function

' Favorites section, then recent links not already favorited.
function Rebuild() as void
    favorites = ValidArray(m.live.favorites)
    recent = ValidArray(m.live.recent)
    favoriteUrls = {}
    for each item in favorites
        favoriteUrls[item.url] = true
    end for

    root = CreateObject("roSGNode", "ContentNode")
    m.items = []
    AddSection(root, "Favorites", favorites)
    others = []
    for each item in recent
        if not favoriteUrls.DoesExist(item.url)
            others.Push(item)
        end if
    end for
    AddSection(root, "Recent", others)

    m.list.content = root
    isEmpty = m.items.Count() = 0
    m.emptyState.visible = isEmpty
    m.list.visible = not isEmpty
    m.hint.visible = not isEmpty
    m.top.focusable = not isEmpty
end function

function AddSection(root as object, title as string, items as object) as void
    if items.Count() = 0
        return
    end if
    section = root.createChild("ContentNode")
    section.title = title
    for each item in items
        node = section.createChild("ContentNode")
        node.title = `${item.title}  ·  ${UCase(item.format)}`
        m.items.Push(item)
    end for
end function

function OnFocusChange() as void
    if m.top.focus
        NodeSetFocus(m.list, true)
    end if
end function

function OnItemSelected() as void
    item = m.items[m.list.itemSelected]
    if item <> invalid
        m.live.playRequest = item
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Options
        item = m.items[m.list.itemFocused]
        if item <> invalid
            m.live.toggleFavorite = item
        end if
        return true
    end if
    if NavigationKeyHandler(key, press).handled
        return true
    end if
    return false
end function
