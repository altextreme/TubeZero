' YourTube: Roboto has no emoji and no CJK/Arabic/Hebrew/Indic glyphs. Emoji are dropped (no font on the
' TV draws them); text in other scripts should use the Roku system font instead of showing empty boxes.
namespace YourTubeText

    ' { text: cleaned text, needsSystemFont: true when Roboto can't draw it }
    function Clean(text as string) as object
        cleaned = ""
        needsSystemFont = false
        lastEmoji = -2
        for i = 0 to text.Len() - 1
            ch = text.Mid(i, 1)
            code = Asc(ch)
            isEmoji = code >= &h1F000 or (code >= &h2600 and code <= &h27BF) or code = &hFE0F or code = &h200D
            if isEmoji
                lastEmoji = i
            else
                ' an emoji between two words ("STREAM🔥BILLIONS") becomes a space, not a merged word
                if lastEmoji = i - 1 and IsWordChar(code) and cleaned <> "" and IsWordChar(Asc(cleaned.Right(1)))
                    cleaned += " "
                end if
                cleaned += ch
                if code >= &h0590 and (code < &h2000 or code > &h2BFF)
                    needsSystemFont = true
                end if
            end if
        end for
        ' a dropped emoji between words leaves a double space
        while cleaned.InStr("  ") >= 0
            cleaned = cleaned.Replace("  ", " ")
        end while
        return { text: cleaned.Trim(), needsSystemFont: needsSystemFont }
    end function

    function IsWordChar(code as integer) as boolean
        return (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code >= &hC0
    end function

    ' Regular system font at the given size (same trick as SystemBoldFont below).
    function SystemFont(size as integer) as object
        font = CreateObject("roSGNode", "Font")
        font.uri = "font:" + "SystemFontFile"
        font.size = size
        return font
    end function

    ' Bold system font at the given size. The URI is built from two strings so the theme plugin
    ' (which maps system font files to Roboto) leaves it alone.
    function SystemBoldFont(size as integer) as object
        font = CreateObject("roSGNode", "Font")
        font.uri = "font:" + "BoldSystemFontFile"
        font.size = size
        return font
    end function

end namespace
