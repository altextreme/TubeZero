import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"

function Init()
    m.top.focusable = true
    m.heading = m.top.findNode("HeadingLabel")
    m.hint = m.top.findNode("HintLabel")
    m.rowList = m.top.findNode("rowList")
    m.rowList.screen = m.top
end function

function OnNodeReady()
    query = m.top.query
    m.heading.text = `Watch history: "${query}"`
    m.hint.text = "Videos from your watch history whose title or channel matches. Back to close."
    m.rowList@.BindNode()
    m.rowList.feeds = [{
        title: "Results"
        feedSources: [{
            id: "yt_history_search"
            title: "Results"
            apiType: "Invidious"
            endpoint: "yt_history_search"
            queryParams: { q: query }
        }]
    }]
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    NodeSetFocus(m.rowList, true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Back
        m.appController@.PopScreen()
        return true
    end if
    return false
end function
