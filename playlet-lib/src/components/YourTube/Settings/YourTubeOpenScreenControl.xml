<!--
    YourTube: Settings button that opens a full page (Settings > More: Phone remote, About). The preference key
    picks the screen, see YourTubeOpenScreenControl.bs. Same look as ClearCacheControl.
-->
<component name="YourTubeOpenScreenControl" extends="LayoutGroup" includes="Focus">
    <interface>
        <field id="displayText" type="string" alias="Button.text" />
        <field id="description" type="string" alias="DescriptionLabel.text" />
        <function name="BindPreference" />
    </interface>
    <children>
        <Button
            id="Button"
            minWidth="0"
            showFocusFootprint="true" />
        <Label id="DescriptionLabel"
            width="450"
            color="0xb4b4b4ff"
            wrap="true">
            <Font role="font" uri="font:SystemFontFile" size="18" />
        </Label>
    </children>
</component>
