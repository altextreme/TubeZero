import "pkg:/components/Dialog/DialogUtils.bs"
import "pkg:/components/YourTube/Pairing/YourTubePairing.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Types.bs"

' YourTube: preference key (config/preferences.json5, category "more") -> screen it opens
function Init()
    m.top.focusable = true
    m.top.itemSpacings = [8]
    m.screensByKey = {
        "more.phone_remote": "RemoteScreen"
        "more.about": "AppInfoScreen"
    }
    m.key = ""
    m.button = m.top.findNode("Button")
    m.button.observeField("buttonSelected", FuncName(OnButtonSelected))
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    NodeSetFocus(m.button, true)
end function

function BindPreference(_preferences as object, key as string)
    m.key = key
end function

function OnButtonSelected() as void
    ' TubeZero: keys that run an action instead of opening a page
    if m.key = "more.forget_phones"
        ForgetPairedPhones()
        return
    end if
    screenName = m.screensByKey[m.key]
    if screenName = invalid
        return
    end if
    appController = m.top.getScene().findNode("AppController")
    if appController = invalid
        return
    end if
    page = CreateObject("roSGNode", "YourTubeStandaloneScreen")
    page.heading = m.top.displayText
    appController@.PushScreen(page)
    page.screenName = screenName
end function

' TubeZero: revoke every phone pairing token (YourTubePairing); phones are asked for a new code next time.
function ForgetPairedPhones() as void
    pairedCount = YourTubePairing.Count()
    YourTubePairing.ForgetAll()
    message = "No phones were paired."
    if pairedCount = 1
        message = "1 phone was unpaired. It will be asked for a new code next time."
    else if pairedCount > 1
        message = `${pairedCount} phones were unpaired. They will be asked for a new code next time.`
    end if
    DialogUtils.ShowDialogEx({ title: "Forget paired phones", message: message })
end function
