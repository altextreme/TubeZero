import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"

' YourTube: see YourTubeStandaloneScreen.xml
function Init()
    m.top.focusable = true
    m.slot = m.top.findNode("ScreenSlot")
    m.screen = invalid
end function

function OnScreenNameChange() as void
    if m.screen <> invalid
        return
    end if
    ' Create, flag, then attach: the screen binds and wires Back/Left as soon as it joins the tree, so the
    ' standalone flag must already be set (otherwise Back goes to the hidden nav rail).
    m.screen = CreateObject("roSGNode", m.top.screenName)
    if m.screen = invalid
        return
    end if
    ' RemoteScreen: don't route Back/Left to the (hidden) nav rail
    if m.screen.hasField("standalone")
        m.screen.standalone = true
    end if
    m.slot.appendChild(m.screen)
    if m.screen.hasField("binding_done")
        m.screen@.BindNode()
    end if
    ' PushScreen asks for focus before screenName is set, so take it now if this page is the one that should have it
    if m.top.focus or m.top.isInFocusChain()
        FocusHostedScreen()
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    FocusHostedScreen()
end function

function FocusHostedScreen() as void
    if m.screen <> invalid and m.screen.focusable
        NodeSetFocus(m.screen, true)
        return
    end if
    ' nothing focusable inside (yet): hold focus here so Back still closes the page
    ' bs:disable-next-line NO_SET_FOCUS
    m.top.setFocus(true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Back
        Close()
        return true
    end if
    ' Keep keys (e.g. Left at the edge) from reaching the screens underneath
    return true
end function

function Close() as void
    if m.screen <> invalid
        ' RemoteScreen cancels its pairing-code job when it goes invisible
        m.screen.visible = false
    end if
    appController = m.top.getScene().findNode("AppController")
    if appController <> invalid
        appController@.PopScreen()
    end if
end function
