import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"

' YourTube: see YourTubeStandaloneScreen.xml
function Init()
    m.top.focusable = true
    m.slot = m.top.findNode("ScreenSlot")
    m.screen = invalid
end function

function OnScreenNameChange() as void
    if m.screen <> invalid
        return
    end if
    m.screen = m.slot.createChild(m.top.screenName)
    if m.screen = invalid
        return
    end if
    ' RemoteScreen: don't route Back/Left to the (hidden) nav rail
    if m.screen.hasField("standalone")
        m.screen.standalone = true
    end if
    if m.screen.hasField("binding_done")
        m.screen@.BindNode()
    end if
    if m.top.isInFocusChain()
        FocusHostedScreen()
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    FocusHostedScreen()
end function

function FocusHostedScreen() as void
    if m.screen <> invalid and m.screen.focusable
        NodeSetFocus(m.screen, true)
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Back
        Close()
        return true
    end if
    ' Keep keys (e.g. Left at the edge) from reaching the screens underneath
    return true
end function

function Close() as void
    if m.screen <> invalid
        ' RemoteScreen cancels its pairing-code job when it goes invisible
        m.screen.visible = false
    end if
    appController = m.top.getScene().findNode("AppController")
    if appController <> invalid
        appController@.PopScreen()
    end if
end function
