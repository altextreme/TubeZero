<!--
    YourTube: "Notifications" pill on the Profile screen (top right), with the unread count from
    m.global.yourtubeLibrary.unseenCount. Shown only for a signed-in YouTube profile (the screen sets `visible`).
    OK raises `selected`.
-->
<component name="YourTubeNotificationsButton" extends="Group">
    <interface>
        <field id="count" type="integer" value="-1" onChange="Layout" />
        <field id="selected" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Poster id="Pill" uri="pkg:/images/yt-pill-dark.$$RES$$.9.png" height="45">
            <Label id="PillLabel" color="0xEBEBEBFF" height="45" vertAlign="center" translation="[22,0]">
                <Font role="font" uri="font:MediumSystemFontFile" size="19" />
            </Label>
            <Poster id="Badge" uri="pkg:/images/white-circle.png" blendColor="0xCC0000FF" width="28" height="28" translation="[0,8]">
                <Label id="BadgeLabel" color="0xF1F1F1FF" width="28" height="28" horizAlign="center" vertAlign="center">
                    <Font role="font" uri="font:MediumSystemFontFile" size="14" />
                </Label>
            </Poster>
        </Poster>
    </children>
</component>
