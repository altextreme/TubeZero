import "pkg:/components/ChannelView/ChannelUtils.bs"
import "pkg:/components/Services/Invidious/InvidiousToContentNode.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.top.focusable = true
    m.top.findNode("HeadingLabel").text = "Notifications"
    m.statusLabel = m.top.findNode("StatusLabel")
    m.list = m.top.findNode("NotificationList")
    m.list.observeField("itemSelected", FuncName(OnItemSelected))
    m.notifications = []
end function

function OnNodeReady()
end function

function OnStatusChange() as void
    m.statusLabel.text = m.top.status
    m.statusLabel.visible = m.top.status <> ""
    m.list.translation = [120, 120]
    if m.top.status <> ""
        m.list.translation = [120, 140]
    end if
end function

function OnItemsChange() as void
    m.notifications = ValidArray(m.top.items)
    content = CreateObject("roSGNode", "ContentNode")
    for each notification in m.notifications
        item = content.createChild("ContentNode")
        item.addFields({ avatar: ValidString(notification.thumbnail), videoThumbnail: ValidString(notification.videoThumbnail), unread: notification.read <> true })
        item.title = ValidString(notification.message)
        item.description = ValidString(notification.time)
    end for
    m.list.content = content
    if m.top.isInFocusChain()
        NodeSetFocus(m.list, true)
    end if
end function

' Plays the video or opens the channel the notification points at.
function OnItemSelected() as void
    index = m.list.itemSelected
    if index < 0 or index >= m.notifications.Count()
        return
    end if
    notification = m.notifications[index]
    videoId = ValidString(notification.videoId)
    channelId = ValidString(notification.channelId)
    if videoId <> ""
        video = InvidiousContent.ToVideoContentNode(invalid, { videoId: videoId, title: ValidString(notification.message) }, invalid)
        m.videoQueue.playVideo = video
    else if channelId <> ""
        ChannelUtils.Open(InvidiousContent.ToChannelContentNode(invalid, { authorId: channelId }), m.appController)
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    NodeSetFocus(m.list, true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if press and key = RemoteKeys.Back
        m.appController@.PopScreen()
        return true
    end if
    return false
end function
