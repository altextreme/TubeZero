import "pkg:/source/utils/Types.bs"

' YourTube: shared look for Playlet's row lists (white focus ring, row titles).
function YourTubeStyleRowList(rowList as object) as void
    rowList.focusBitmapUri = "pkg:/images/yt-focus-ring.$$RES$$.9.png"
    rowList.rowLabelColor = "#EBEBEBFF"

    font = CreateObject("roSGNode", "Font")
    font.uri = "font:BoldSystemFontFile"
    font.size = 20
    rowList.rowLabelFont = font

    ' Cards can't reach their RowList on device, so hand them the per-row sizes through the content tree.
    rowList.ObserveField("content", FuncName(YourTubeOnRowListContent))
end function

function YourTubeOnRowListContent(event as object) as void
    content = event.getData()
    if content = invalid
        return
    end if
    sizes = { ytRowItemSize: m.top.rowItemSize }
    if content.hasField("ytRowItemSize")
        content.setFields(sizes)
    else
        content.addFields(sizes)
    end if
end function

' YourTube: search keyboard with no key backgrounds, a white focus and a pill-shaped field.
function YourTubeStyleKeyboard(keyboard as object) as void
    palette = CreateObject("roSGNode", "RSGPalette")
    palette.colors = {
        KeyboardColor: "#161616FF"
        PrimaryTextColor: "#BBBBBBFF"
        SecondaryTextColor: "#AAAAAAFF"
        FocusColor: "#EBEBEBFF"
        FocusItemColor: "#161616FF"
        InputFieldColor: "#282828FF"
    }
    keyboard.palette = palette

    textEditBox = keyboard.textEditBox
    textEditBox.hintText = "Search"
    textEditBox.hintTextColor = "#AAAAAAFF"
    textEditBox.textColor = "#EBEBEBFF"
    ' White pill: the keyboard tints it with InputFieldColor (a dark pill came out black on the TV).
    ' The pill is drawn by the screen (searchFieldPill); the text box itself is shifted in from its left edge.
    textEditBox.backgroundUri = "pkg:/images/yt-transparent.png"
    textEditBox.translation = [18, textEditBox.translation[1]]
    YourTubePadSearchField(keyboard)

    ' No key backgrounds or separators; rounded white focus like the YouTube TV keyboard.
    keyGrid = keyboard.keyGrid
    keyGrid.keyBitmapUri = "pkg:/images/yt-transparent.png"
    keyGrid.focusBitmapUri = "pkg:/images/yt-rounded.$$RES$$.9.png"
end function

' The Roku text box draws its text at x=0 inside the pill; nudge its label in. Called again on edits
' because the text box builds and re-lays out its label after Init.
function YourTubePadSearchField(keyboard as object) as void
    for each child in keyboard.textEditBox.getChildren(-1, 0)
        if child.subtype() = "Label"
            child.translation = [18, child.translation[1]]
            exit for
        end if
    end for
end function
