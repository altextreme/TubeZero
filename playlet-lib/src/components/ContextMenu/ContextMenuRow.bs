function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    m.top.text = content.title
end function

function OnItemHasFocus()
    hasFocus = m.top.itemHasFocus
    if hasFocus
        m.top.font = RowFont(true) ' YourTube: Roboto (was font:SmallestBoldSystemFont)
        m.top.color = "#262626ff"
    else
        m.top.font = RowFont(false) ' YourTube: Roboto (was font:SmallestSystemFont)
        m.top.color = "#EBEBEBFF"
    end if
end function

function OnFocusPercent()
    if m.top.focusPercent > 0.5
        m.top.font = RowFont(true) ' YourTube: Roboto (was font:SmallestBoldSystemFont)
        m.top.color = "#262626FF"
    else
        m.top.font = RowFont(false) ' YourTube: Roboto (was font:SmallestSystemFont)
        m.top.color = "#EBEBEBFF"
    end if
end function

' YourTube: cached Roboto fonts for the focused / resting row
function RowFont(focused as boolean) as object
    key = "fontResting"
    uri = "pkg:/fonts/roboto/Roboto-Regular.ttf"
    if focused
        key = "fontFocused"
        uri = "pkg:/fonts/roboto/Roboto-Medium.ttf"
    end if
    if m[key] = invalid
        font = CreateObject("roSGNode", "Font")
        font.uri = uri
        font.size = 18
        m[key] = font
    end if
    return m[key]
end function
