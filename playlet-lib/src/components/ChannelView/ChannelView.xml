<!--
    YourTube: YouTube TV-style channel page. Dimmed banner, round avatar, name and handle/subscriber line,
    Subscribe and Play all on the right, tab chips (search, Videos, Shorts, Live, Playlists...) and the
    selected tab as a 3-column grid. Focusing the grid slides the header up so more cards fit; Up from the
    grid's first row brings the tabs back, Up again the Subscribe / Play all actions.
    (Playlet showed every tab as its own row under a sliding banner.)
-->
<component name="ChannelView" extends="Group" includes="AutoBind,Focus,ContextMenuProvider,Disposable">
    <interface>
        <field id="content" type="node" onChange="OnContentSet" />
        <field id="authorId" type="string" onChange="OnAuthorIdChange" />
        <field id="isSubscribed" type="boolean" onChange="OnSubscriptionChanged" />
        <field id="appController" type="node" bind="/AppController" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="profilesService" type="node" bind="/ProfilesService" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="jobQueue" type="node" bind="/JobQueue" />
        <field id="bookmarksService" type="node" bind="/BookmarksService" />
        <!-- YourTube: Play all queues the channel's videos -->
        <field id="videoQueue" type="node" bind="/VideoQueue" />
        <function name="ShowSortDialog" />
    </interface>
    <children>
        <Rectangle
            width="1280"
            height="720"
            color="0x242424">
        </Rectangle>

        <Group id="container">
            <Poster
                id="banner"
                width="1280"
                height="210"
                loadWidth="1280"
                loadHeight="212"
                loadDisplayMode="scaleToZoom"
                opacity="0.55"
                visible="false" />
            <Poster
                id="bannerScrim"
                uri="pkg:/images/yt-player-scrim.png"
                translation="[0,90]"
                width="1280"
                height="120"
                blendColor="0x0F0F0FFF"
                visible="false" />

            <Poster
                id="avatarRing"
                translation="[88,108]"
                width="100"
                height="100"
                blendColor="0x0F0F0FFF"
                uri="pkg:/images/white-circle.png">
                <CirclePoster
                    id="thumbnail"
                    width="92"
                    height="92"
                    translation="[4,4]"
                    failedBitmapUri="pkg:/images/thumbnail-missing.jpg" />
            </Poster>

            <Label
                id="authorLabel"
                translation="[208,118]"
                width="600"
                color="0xF1F1F1FF"
                wrap="false">
                <Font role="font" uri="font:BoldSystemFontFile" size="30" />
            </Label>
            <Label
                id="subCountLabel"
                translation="[208,162]"
                width="600"
                color="0xAAAAAAFF"
                wrap="false">
                <Font role="font" uri="font:SystemFontFile" size="16" />
            </Label>

            <!-- Subscribe (signed in) and Play all; right-aligned in code -->
            <YourTubeChipBar
                id="actionsBar"
                translation="[880,140]"
                maxWidth="320"
                activeIndex="-1" />

            <YourTubeChipBar
                id="tabsBar"
                translation="[90,236]"
                maxWidth="1110" />

            <Label
                id="gridMessage"
                translation="[90,310]"
                width="1100"
                color="0xAAAAAAFF"
                visible="false">
                <Font role="font" uri="font:SystemFontFile" size="20" />
            </Label>

            <YourTubeVideoGrid
                id="videoGrid"
                itemComponentName="RowCell"
                translation="[0,292]"
                numRows="2"
                columns="3"
                requireSignIn="false"
                rowItemSize="[[350,196]]"
                rowItemSpacing="[[25,0]]"
                rowHeights="[326]"
                itemSize="[1280,326]"
                itemSpacing="[0,0]"
                focusXOffset="[90]"
                showRowLabel="[false]"
                rowFocusAnimationStyle="floatingfocus" />
        </Group>

        <Animation id="layoutAnimation" duration="0.2" easeFunction="outQuad">
            <Vector2DFieldInterpolator id="containerMove" key="[0.0,1.0]" fieldToInterp="container.translation" />
        </Animation>
    </children>
</component>
