import "pkg:/source/utils/Types.bs" ' YourTube: FuncName

function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    m.top.titleLabelText = content.text
    m.top.titleLabelFocusedText = content.text

    isProfile = content.isProfile
    if isProfile
        m.top.iconPosterVisible = false
        m.top.profileIconVisible = true
    else
        m.top.iconPosterVisible = true
        m.top.profileIconVisible = false
        m.top.iconPosterUri = content.icon
    end if

    OnListHasFocusChange()
end function

function OnItemHasFocusChange() as void
    itemHasFocus = m.top.itemHasFocus
    m.top.titleLabelFocusedVisible = itemHasFocus
    m.top.titleLabelVisible = not itemHasFocus
    UpdateIconColor()
end function

function OnListHasFocusChange()
    listHasFocus = m.top.listHasFocus
    if not listHasFocus
        m.top.titleLabelFocusedVisible = false
        m.top.titleLabelVisible = false
        m.top.opacity = 1 ' YourTube: full white for the current section (was 0.8)
        UpdateIconColor()
    else
        OnItemHasFocusChange()
        m.top.opacity = 1
    end if
end function

' YourTube: like the YouTube TV rail. Focused item: dark filled icon on the white pill. Current section:
' white filled icon. Everything else: gray outlined icon. Same rules expanded or collapsed.
function UpdateIconColor() as void
    iconPoster = m.top.findNode("IconPoster")
    content = m.top.itemContent
    if content = invalid or content.isProfile
        return
    end if
    if not m.observingCurrent = true
        m.global.ObserveFieldScoped("ytNavCurrent", FuncName(UpdateIconColor))
        m.observingCurrent = true
    end if

    onPill = m.top.itemHasFocus and m.top.listHasFocus
    isCurrent = content.screen = m.global.ytNavCurrent
    icon = content.icon
    if (onPill or isCurrent) and icon.InStr("/icons/ms/") <> -1
        icon = icon.Replace(".png", "_fill.png")
    end if
    iconPoster.uri = icon
    if onPill
        iconPoster.blendColor = "#161616FF"
    else if isCurrent
        iconPoster.blendColor = "#EBEBEBFF"
    else
        iconPoster.blendColor = "#929292FF"
    end if
end function
