import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    ' TODO:P2 make component disposable, and stop animation when component is disposed
    m.background = m.top.findNode("background")
    m.titleLine1 = m.top.findNode("titleLine1")
    m.titleLine2 = m.top.findNode("titleLine2")
    m.channelLine = m.top.findNode("channelLine")
    m.size = [350, 196]
    m.top.observeField("visible", FuncName(OnVisibleChanged))
    OnVisibleChanged()
end function

function OnVisibleChanged()
    Animate()
end function

function OnIndexSet()
    ' YourTube: a gentle left-to-right ripple across the row
    m.top.animationDelay = (m.top.index mod 5) * 0.12
    Animate()
end function

function Animate()
    m.top.animationControl = m.top.visible ? "start" : "stop"
end function

' YourTube: take the row's card size (Home's first shelf is 480x270), the same way YourTubeVideoCell does:
' the row list stamps rowItemSize on the content root; content -> row -> root.
function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if
    row = content.getParent()
    if row = invalid
        return
    end if
    root = row.getParent()
    if root = invalid or not root.hasField("ytRowItemSize")
        return
    end if
    sizes = root.ytRowItemSize
    if not IsArray(sizes) or sizes.Count() = 0
        return
    end if
    rowIndex = 0
    for i = 0 to root.getChildCount() - 1
        if root.getChild(i).isSameNode(row)
            rowIndex = i
            exit for
        end if
    end for
    size = sizes[MathUtils.Min(rowIndex, sizes.Count() - 1)]
    if IsArray(size) and size.Count() >= 2
        SetSize(size[0], size[1])
    end if
end function

function SetSize(width as float, height as float) as void
    if m.size[0] = width and m.size[1] = height
        return
    end if
    m.size = [width, height]
    m.background.width = width
    m.background.height = height
    ' text placeholders sit where the card's title and channel lines go (title starts at height + 22)
    m.titleLine1.width = width * 0.9
    m.titleLine1.translation = [0, height + 24]
    m.titleLine2.width = width * 0.6
    m.titleLine2.translation = [0, height + 48]
    m.channelLine.width = width * 0.35
    m.channelLine.translation = [0, height + 76]
end function
