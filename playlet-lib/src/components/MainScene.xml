<component name="MainScene" extends="Group" includes="AutoBind">
    <children>
        <!-- Logger should remain the first child, to make sure it is initialized first in the scene -->
        <Logger id="Logger" />
        <JobQueue id="JobQueue" />
        <!-- YourTube: Live tab state + stream playback (m.global.yourtubeLive) -->
        <YourTubeLiveService id="YourTubeLiveService" />
        <!-- YourTube: save to playlist, Not interested, Watch Later edits (m.global.yourtubeLibrary) -->
        <YourTubeLibraryService id="YourTubeLibraryService" />
        <AppController id="AppController"
            screensContainer="bind:./AppScreens"
            root="bind:./AppRoot"
            stack="bind:./Stack"
            videoQueue="bind:./VideoQueue">
            <Group id="Stack">
                <AppRoot id="AppRoot">
                    <AppScreens id="AppScreens" />
                    <NavBar id="NavBar"
                        initialFocus="2"
                        appController="bind:/AppController"
                        screensContainer="bind:../AppScreens">
                        <ContentNode role="content">
                            <NavBarItemContent
                                screen="ProfileScreen"
                                text="Profile"
                                isProfile="true" />
                            <NavBarItemContent
                                screen="SearchScreen"
                                text="Search"
                                icon="pkg:/images/icons/search.png" />
                            <NavBarItemContent
                                screen="HomeScreen"
                                text="Home"
                                icon="pkg:/images/icons/home.png" />
                            <!-- YourTube: YouTube TV sections -->
                            <NavBarItemContent
                                screen="YourTubeShortsScreen"
                                text="Shorts"
                                icon="pkg:/images/icons/ms/shorts.png" />
                            <NavBarItemContent
                                screen="YourTubeSubscriptionsScreen"
                                text="Subscriptions"
                                icon="pkg:/images/icons/ms/subscriptions.png" />
                            <NavBarItemContent
                                screen="YourTubeYouScreen"
                                text="You"
                                icon="pkg:/images/icons/ms/video_library.png" />
                            <NavBarItemContent
                                screen="YourTubeLiveScreen"
                                text="Live"
                                icon="pkg:/images/icons/ms/live_tv.png" />
                            <!-- YourTube: Bookmarks moved into You (rows after history/playlists);
                                 Remote and Info moved into Settings > More (YourTubeOpenScreenControl) -->
                            <NavBarItemContent
                                screen="SettingsScreen"
                                text="Settings"
                                icon="pkg:/images/icons/settings.png" />
                        </ContentNode>
                    </NavBar>
                </AppRoot>
            </Group>

            <!-- YourTube: no clock on browse screens (YouTube TV has none; it overlapped the top bar logo).
                 The player keeps its own clock. -->
            <Clock visible="false" />
            <VideoContainer id="VideoContainer" />
            <Group id="Notifications" />

            <!--  No render nodes -->
            <VideoQueue id="VideoQueue"
                appController="bind:/AppController"
                videoContainer="bind:../VideoContainer"
                innertube="bind:../Innertube"
                invidious="bind:../Invidious"
                notifications="bind:../Notifications"
                preferences="bind:../Preferences"
                loungeService="bind:../LoungeService"
                jobQueue="bind:/JobQueue" />

            <ApplicationInfo id="ApplicationInfo"
                jobQueue="bind:/JobQueue" />
            <Preferences id="Preferences" />
            <BookmarksService id="BookmarksService" />
            <SearchHistory id="SearchHistory"
                preferences="bind:../Preferences" />

            <ProfilesService id="ProfilesService"
                invidious="bind:../Invidious"
                jobQueue="bind:/JobQueue" />

            <Innertube id="Innertube"
                jobQueue="bind:/JobQueue" />
            <Invidious id="Invidious"
                webServer="bind:../WebServer"
                applicationInfo="bind:../ApplicationInfo"
                preferences="bind:../Preferences"
                profilesService="bind:../ProfilesService" />

            <!-- Tasks -->
            <PlayletWebServer id="WebServer"
                port="8888"
                appController="bind:/AppController"
                applicationInfo="bind:../ApplicationInfo"
                innertube="bind:../Innertube"
                invidious="bind:../Invidious"
                profilesService="bind:../ProfilesService"
                preferences="bind:../Preferences"
                videoQueue="bind:../VideoQueue"
                bookmarksService="bind:../BookmarksService"
                loungeService="bind:../LoungeService"
                jobQueue="bind:/JobQueue" />
            <DialServer id="DialServer"
                webServer="bind:../WebServer"
                loungeService="bind:../LoungeService" />
            <LoungeService id="LoungeService"
                videoQueue="bind:../VideoQueue"
                notifications="bind:../Notifications"
                invidious="bind:../Invidious" />
            <Telemetry id="Telemetry"
                preferences="bind:../Preferences"
                applicationInfo="bind:../ApplicationInfo" />
        </AppController>
        <!-- YourTube: top-most layer for YourTubeDialog -->
        <YourTubeDialogHost id="YourTubeDialogHost" />
    </children>
</component>