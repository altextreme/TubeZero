[
  {
    displayText: "Playback",
    key: "playback",
    description: "Playback preferences",
    children: [
      {
        displayText: "Autoplay",
        key: "playback.autoplay",
        description: "When you finish a video, another plays automatically",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Preferred quality",
        key: "playback.preferred_quality",
        description: "Preferred video quality",
        type: "string",
        defaultValue: "auto",
        visibility: "tv",
        rokuComponent: "EditQualityControl",
      },
      {
        displayText: "Preferred quality",
        key: "playback.preferred_quality",
        description: "Preferred video quality",
        visibility: "web",
        svelteComponent: "EditQualityControl",
      },
      {
        displayText: "Disable auto-dubbed audio",
        key: "playback.disable_auto_dubbed",
        description: "Remove AI-generated dubbed audio tracks.",
        type: "boolean",
        defaultValue: false,
      },
      {
        // YourTube: checked in MarkVideoWatchedJob (no history ping, no watch-time reports)
        displayText: "Pause watch history",
        key: "playback.pause_watch_history",
        description: "Videos you watch on this TV aren't added to your account's watch history, and resume points aren't saved to it.",
        type: "boolean",
        defaultValue: false,
      },
      {
        // YourTube: a short Left/Right press with the player controls hidden skips 10 seconds
        displayText: "Quick 10-second skip",
        key: "playback.quick_skip",
        description: "With the player controls hidden, a short Left or Right press skips 10 seconds. Hold to scrub.",
        type: "boolean",
        defaultValue: true,
      },
      {
        // YourTube: the caption language picked with the player's CC button ("" follows Roku's setting,
        // "off" keeps captions off, else a 3-letter code like "eng"). Set from the player, not Settings.
        displayText: "Captions language",
        key: "playback.captions_language",
        description: "Caption language chosen in the player.",
        visibility: "off",
        type: "string",
        defaultValue: "",
      },
    ],
  },
  {
    displayText: "Backend",
    key: "backend",
    description: "Backend preferences",
    children: [
      {
        displayText: "Selected backend",
        key: "backend.selected",
        description: "The backend used for browsing and playing videos.",
        type: "radio",
        defaultValue: "playlet",
        options: [
          {
            displayText: "Playlet (local)",
            value: "playlet",
          },
          {
            displayText: "Invidious",
            value: "invidious",
          },
        ],
      },
    ],
  },
  {
    displayText: "Content Feed",
    key: "content_feed",
    description: "Feed preferences",
    children: [
      {
        displayText: "Disable Shorts",
        key: "content_feed.disable_shorts",
        description: "Disable short videos.",
        type: "boolean",
        defaultValue: false,
      },
      {
        // YourTube: Shorts tab feed source (also toggled from the chip on the Shorts screen)
        displayText: "Shorts from subscriptions only",
        key: "content_feed.shorts_subscriptions_only",
        description: "The Shorts tab starts with Shorts from channels you subscribe to. Needs a YouTube account.",
        type: "boolean",
        defaultValue: false,
      },
      // TubeZero: YourTubeText.FixCaps (synced to the global ytFixCapsTitles field by Preferences.bs)
      {
        displayText: "Fix ALL-CAPS titles",
        key: "content_feed.fix_caps_titles",
        description: "Show titles written in all capitals in sentence case, keeping acronyms like NBA or 4K.",
        type: "boolean",
        defaultValue: true,
      },
      // TubeZero: blocklist (YourTubeBlocklist), comma-separated
      {
        displayText: "Blocked channels",
        key: "content_feed.blocked_channels",
        description: "Comma-separated channel names or IDs. Their videos are hidden from every feed and search. Long-press a card to add one.",
        type: "string",
        defaultValue: "",
      },
      {
        displayText: "Blocked keywords",
        key: "content_feed.blocked_keywords",
        description: "Comma-separated words. Videos whose title contains one are hidden from every feed and search.",
        type: "string",
        defaultValue: "",
      },
    ],
  },
  {
    displayText: "Invidious",
    key: "invidious",
    description: "Invidious preferences",
    children: [
      {
        displayText: "Instance",
        key: "invidious.instance",
        description: "Invidious instance to use. Example: https://example.com. Find more instances at %INVIDIOUS_PUBLIC_INSTANCES%",
        type: "string",
        visibility: "web",
      },
      {
        displayText: "Instance",
        key: "invidious.instance",
        description: "Invidious instance to use. Example: https://example.com",
        visibility: "tv",
        rokuComponent: "InvidiousInstanceControl",
      },
      {
        displayText: "Proxy videos",
        key: "invidious.proxy_videos",
        description: "Proxy videos through the Invidious server. This is useful if videos are geoblocked.",
        type: "radio",
        defaultValue: "if_needed",
        options: [
          {
            displayText: "Always",
            value: "always",
          },
          {
            displayText: "Only if needed",
            value: "if_needed",
          },
          {
            displayText: "Never",
            value: "never",
          },
        ],
      },
    ],
  },
  {
    // YourTube: dislike counts in the player (returnyoutubedislikeapi.com)
    displayText: "Return YouTube Dislike",
    key: "ryd",
    description: "Dislike counts from Return YouTube Dislike",
    children: [
      {
        displayText: "Show dislike counts",
        key: "ryd.enabled",
        description: "Show estimated dislike counts in the player. Asks returnyoutubedislikeapi.com about each video you open.",
        type: "boolean",
        defaultValue: true,
      },
    ],
  },
  {
    displayText: "SponsorBlock",
    key: "sponsorblock",
    description: "SponsorBlock preferences",
    children: [
      {
        displayText: "Enabled",
        key: "sponsorblock.enabled",
        description: "Enable SponsorBlock",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Show notifications",
        key: "sponsorblock.show_notifications",
        description: "Show notifications when a segment is skipped",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Categories",
        key: "sponsorblock.categories",
        description: "Configure which segments to skip",
        type: "assocarray",
        visibility: "tv",
        rokuComponent: "SponsorBlockCategoriesControl",
        defaultValue: {
          // TODO:P1 support for exclusive_access and chapter
          sponsor: {
            option: "auto_skip",
          },
          selfpromo: {
            option: "manual_skip",
          },
          interaction: {
            option: "manual_skip",
          },
          poi_highlight: {
            // YourTube: "Ask" = a "Jump to highlight" prompt near the start (was show_in_seekbar)
            option: "manual_skip",
          },
          intro: {
            option: "manual_skip",
          },
          outro: {
            option: "manual_skip",
          },
          preview: {
            option: "manual_skip",
          },
          hook: {
            option: "manual_skip",
          },
          filler: {
            option: "manual_skip",
          },
          music_offtopic: {
            option: "manual_skip",
          },
        },
      },
      {
        displayText: "Categories",
        key: "sponsorblock.categories",
        description: "Configure which segments to skip",
        visibility: "web",
        svelteComponent: "SponsorBlockCategoriesControl",
      },
    ],
  },
  {
    displayText: "Search History",
    key: "search_history",
    description: "Search history preferences",
    children: [
      {
        displayText: "Enable search history",
        key: "search_history.enabled",
        description: "Enable search history",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Clear search history",
        key: "search_history.clear_search_history",
        description: "Clear search history from Playlet. This affects the search suggestions. This does not affect the watch history on Invidious.",
        visibility: "web",
        svelteComponent: "ClearSearchHistoryControl",
      },
      {
        displayText: "Clear search history",
        key: "search_history.clear_search_history",
        description: "Clear search history from Playlet. This affects the search suggestions. This does not affect the watch history on Invidious.",
        visibility: "tv",
        rokuComponent: "ClearSearchHistoryControl",
      },
      {
        // This one doesn't belong to "search history" but
        // it can be refactored into "search" later.
        displayText: "Search keyboard language",
        key: "search.keyboard_language",
        description: "Preferred language for the on-screen keyboard.",
        // This preference is not visible in the settings, but is used
        // in the search keyboard component.
        visibility: "off",
        type: "radio",
        defaultValue: "en_US",
        options: [
          { displayText: "English", value: "en_US" },
          { displayText: "Deutsch", value: "de_DE" },
          { displayText: "Español", value: "es_ES" },
          { displayText: "Français", value: "fr_FR" },
          { displayText: "Português", value: "pt_BR" },
          { displayText: "Русский", value: "ru_RU" },
        ],
      },
    ],
  },
