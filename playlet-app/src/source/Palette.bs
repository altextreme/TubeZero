function SetScenePalette(scene as object)
    palette = CreateObject("roSGNode", "RSGPalette")
    palette.colors = {
        DialogBackgroundColor: "#212121FF" ' YourTube: dialog surface (was #242424)
        DialogFocusColor: "#CECECEFF"
        DialogFocusItemColor: "#202020FF"
        DialogSecondaryTextColor: "#EBEBEBFF"
        DialogSecondaryItemColor: "#3F3F3FFF" ' YourTube: neutral divider (was red)
        DialogTextColor: "#EBEBEBFF"
    }
    scene.palette = palette
end function
